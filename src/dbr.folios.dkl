#include "dkli.dkh"
#!
module "Gestión de folios :dbr.folios"
{
	@max_autocode_attemps=10
	/*
     * Summary:
     * - db : conexión a la base de datos
     * - ifolio : clave primaria(sys_pk) de la tabla foliosdocumentos
    */
    
    recover_folio_block::&db,ifolio
    {
        if not(dbr.in_transaction(db)) { do rise_error(0,"Se requiere iniciar una transacción de bases de datos.")}

        ifolio >> p
        p<"block">:dbr.num(db,"SELECT block FROM foliosdocumentos WHERE sys_pk=@ifolio",p)

        if @@(p,"#block") < 1{do rise_error(99,"No se encontró datos del block de documentos")}

        do dbr.execute(db,"DELETE FROM foliosdocumentos where sys_pk=@ifolio",p)
        fultimo=dbr.num(db,"SELECT IFNULL(MAX(fd.Folio),0) AS MaxFolio FROM foliosdocumentos fd WHERE block=@block",p)
        do dbr.execute(db,"UPDATE blockdocumentos bd SET bd.FUltimo = "+str(fultimo)+" WHERE bd.sys_pk=@block;",p)
    }
    // Devuele la clave primaria correspondiente al block cuya serie y tipo de documento se indican
    id_block::&db,doctype, serie
    {
        new p
        {
            @"doc":doctype
            @"serie":serie
        }

        return dbr.num(db,"select sys_pk from blockdocumentos where documento=@doc and serie=@serie and activo limit 1;",p)
    }

    // Obtiene el siguiente folio para el block indicado
    get_new::&db, idblock
    {
        new p{@"block":idblock}
        return dbr.num(db,"SELECT IF(finicial > fultimo + 1, finicial, fultimo + 1)
            FROM blockdocumentos
            WHERE sys_pk = @block
            AND activo",p)
    }

    // Establece el folio y retorna su valor si tiene éxito, en caso contrario devuelve cero
    set_new::&db,idblock,folio,intentos
    {
        if not(dbr.in_transaction(db)) { do rise_error(0,"Se requiere iniciar una transacción de bases de datos.")}
        if intentos<1 { intentos=1 }

        new params
        {
            @"iblock":idblock
        }

        new foliosdocumentos
        {
            @"sys_pk":0
            @"sys_guid":uuid()
            @"sys_dtcreated*":dbr.sql("now()")
            @"sys_timestamp*":dbr.sql("now()")
            @"sys_recver":0
            @"cancelado":@false
            @"fecha*":dbr.sql("now()")
            @"folio":folio+0
            @"block":idblock
        }

        res=0

        for i=0;i<intentos
        {
            foliosdocumentos<"folio">:folio
            do dbr.insert(db,"foliosdocumentos",foliosdocumentos)
            do dbr.execute(db,"update blockdocumentos set sys_timestamp=now(), sys_recver=ifnull(sys_recver,0)+1, fultimo="+str(folio)+" where sys_pk=@iblock",params)
            res=folio
            break
            
            exception
            {
                folio=folio+1
            }
        }

        return res
    }

    info::&db,pk_block, folio
    {
        new p
        {
            @"block":pk_block
            @"folio":folio
        }

        return dbr.rec(db,"select sys_pk,sys_guid,cancelado,fecha,folio,block from foliosdocumentos where block=@block and folio=@folio limit 1;",p)
    }

    module ":dbr.autocode"
    {
        info::cad
        {
            prf=""
            sec="0"
            new info {}

            if contains(cad,"|")
            {
                ref a=split(cad,"|")
                prf=list.str(a,0)
                sec=ranydiffchars(list.str(a,1),"0","")
            }

            info<"prefix">:prf
            info<"positions">:length(sec)

            return info
        }

        new::&db, table, field, &config
        {
            prf=""
            num=@@(config,"#start")
            pos=@@(config,"#positions")
            sqlLast="select #<field> from #<table> where #<field> regexp '^[0-9]{#<pos>}$' order by #<field> desc limit 1;"
            
            if num<1 { num=1  }

            if trim(@@(config,"$prefix"))!=""
            {
                prf=trim(@@(config,"$prefix"))+trim(@@(config,"$separator"))
                sqlLast="select #<field> from #<table> where #<field> like '"+prf+"%' order by #<field> desc limit 1;"
            }
            
            ref rec=dbr.rec(db,ftext(sqlLast),@null)
            
            if not(isnull(rec))
            {
                cod=@@(rec,"$"+field)
                if prf!="" { cod=replace(cod,prf,"") }
                cod=ranydiffchars(cod,"0123456789","0")
                num=val(cod)+1
                exception{/*ignore*/}
            }

            fmt=""
            repeat pos {
                fmt=fmt+"0"
            }
	
			for i=0;i<@max_autocode_attemps+1
			{
				autocode=prf+format(num,fmt)
				if isnull(dbr.rec(db,ftext("select #<field> from #<table> where #<field> = '#<autocode>' limit 1;"),@null)) { break }
				num=num+1
			}
			
			return autocode
        }

        ref.mascara_a_formato :: mascara
        {
            fmt = ""
            n = length(mascara)
            i = 0
            en_literal = 0
            hay_digitos = 0

            while i < n
            {
                c = substring(mascara, i, 1)
                if c == "0" || c == "#"
                {
                    if en_literal == 1
                    {
                        fmt = fmt + "'"
                        en_literal = 0
                    }
                    fmt = fmt + c
                    hay_digitos = 1
                }
                else
                {
                    if en_literal == 0
                    {
                        fmt = fmt + "'"
                        en_literal = 1
                    }
                    fmt = fmt + c
                }
                i = i + 1
            }

            if en_literal == 1 { fmt = fmt + "'" }

            // Si la máscara no trae 0 ni #, el folio va al final
            if hay_digitos == 0 { fmt = fmt + "0" }

            return fmt
        }

        get.mascara::db,iblock
        {
            iblock >> params
            if not(isnull(dbr.rec(db,"SHOW COLUMNS FROM blockdocumentos LIKE 'format_ref';",@null)))
            {
                return dbr.str(db,"SELECT IFNULL(format_ref,'0000000000') FROM blockdocumentos where sys_pk",params)
            }

            return "0000000000"
        }
        // serie y folio son obligatorios; la máscara la define el usuario
        reference :: serie, folio, mascara, ref_size
        {
            if mascara == ""
            {
                return serie + padleft(str(folio), ref_size, "0")
            }
            return serie + format(folio, ref.mascara_a_formato(mascara))
        }
    }
}