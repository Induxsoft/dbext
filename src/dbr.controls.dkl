#include "dkli.dkh"
#!
module ":dbr.control"
{
    function GenerateHtml(&db,&controls)
    {
        ref parameters = record.create()

        if isset("@control_params"){ ref parameters:@control_params }
        else if isset("@crud_context"){ ref parameters:@("&parameters") }
        else if isset("@http_context"){ ref parameters:@@(@http_context,"&request/get") }
        
        go foreach.fobj(key:ctrlKey, value:ctrlDef) with(controls)
        {
            control = tolower(trim(@@(ctrlDef,"$control")))
            control = ranydiffchars(control,"abcdefghijklmnopqrstuvwxyz","-")
            control = replace(control,"-","")

            caption = @@(ctrlDef,"$caption")
            if caption == "" { caption = @@(ctrlDef,"$label") }

            name = @@(ctrlDef,"$name")
            if name == "" { name = ctrlKey }

            id = @@(ctrlDef,"$id")
            if id == "" { id = ctrlKey }

            value = @@(parameters,"$"+name)
            if value == "" { value = @@(ctrlDef,"$value") }

            if caption == ""
            {
                caption = ranychars(tolower(trim(name)), "-_.:;/\\", " ")
                first_character = toupper(lremove(caption,1))
                caption = first_character + left(caption,1)
            }

            is_required = parse.bool(trim(@@(ctrlDef,"$required")))
            is_readonly = parse.bool(trim(@@(ctrlDef,"$readonly")))
            is_disabled = parse.bool(trim(@@(ctrlDef,"$disabled")))
            
            required = ifstr(is_required, "required", "")
            readonly = ifstr(is_readonly, "readonly", "")
            disabled = ifstr(is_disabled, "disabled", "")

            wrap_attr = ""
            ref wrap = ifnull(@@(ctrlDef,"&wrp_attr"),record.create())
            ref lst = list.create_from_fields(wrap)
            for i=0; i<list.count(lst)
            {
                attr_key = list.str(lst,i)
                attr_val = field.dstr(wrap,list.str(lst,i),"")
                wrap_attr = wrap_attr + attr_key+' = "'+attr_val+'" '
            }
            wrap_attr = trim(wrap_attr)

            switch control
            {
                case "date"
                {
                    #$
                    div("#<wrap_attr>"="")
                    {
                        label(class="form-label #<ifstr(is_required,'fw-bold','')>" "for"="#<id>"){$"#<caption>"}
                        input(class="form-control rounded-0" type="date" name="#<name>" id="#<id>" value="#<value>" "#<required>"="" "#<readonly>"="" "#<disabled>"="")
                    }
                    #!
                    break
                }
                case "time"
                {
                    #$
                    div("#<wrap_attr>"="")
                    {
                        label(class="form-label #<ifstr(is_required,'fw-bold','')>" "for"="#<id>"){$"#<caption>"}
                        input(class="form-control rounded-0" type="time" name="#<name>" id="#<id>" value="#<value>" "#<required>"="" "#<readonly>"="" "#<disabled>"="")
                    }
                    #!
                    break
                }
                case "datetime"
                {
                    #$
                    div("#<wrap_attr>"="")
                    {
                        label(class="form-label #<ifstr(is_required,'fw-bold','')>" "for"="#<id>"){$"#<caption>"}
                        input(class="form-control rounded-0" type="datetime-local" name="#<name>" id="#<id>" value="#<value>" "#<required>"="" "#<readonly>"="" "#<disabled>"="")
                    }
                    #!
                    break
                }
                case "hexcolor"
                {
                    #$
                    div("#<wrap_attr>"="")
                    {
                        label(class="form-label #<ifstr(is_required,'fw-bold','')>" "for"="#<id>"){$"#<caption>"}
                        input(class="form-control form-control-color rounded-0" type="color" name="#<name>" id="#<id>" value="#<value>" "#<required>"="" "#<readonly>"="" "#<disabled>"="")
                    }
                    #!
                    break
                }
                case "textarea"
                {
                    #$
                    div("#<wrap_attr>"="")
                    {
                        label(class="form-label #<ifstr(is_required,'fw-bold','')>" "for"="#<id>"){$"#<caption>"}
                        textarea(class="form-control rounded-0" name="#<name>" id="#<id>" value="#<value>" "#<required>"="" "#<readonly>"="" "#<disabled>"=""){$"#<value>"}
                    }
                    #!
                    break
                }
                case "number"
                {
                    #$
                    div("#<wrap_attr>"="")
                    {
                        label(class="form-label #<ifstr(is_required,'fw-bold','')>" "for"="#<id>"){$"#<caption>"}
                        input(class="form-control rounded-0" type="number" name="#<name>" id="#<id>" value="#<value>" "#<required>"="" "#<readonly>"="" "#<disabled>"="")
                    }
                    #!
                    break
                }
                case "integer"
                {
                    #$
                    div("#<wrap_attr>"="")
                    {
                        label(class="form-label #<ifstr(is_required,'fw-bold','')>" "for"="#<id>"){$"#<caption>"}
                        input(class="form-control rounded-0" type="number" name="#<name>" id="#<id>" value="#<value>" step="1" oninput="validInteger(this);" "#<required>"="" "#<readonly>"="" "#<disabled>"="")
                    }
                    #!
                    break
                }
                case "decimal"
                {
                    decimals = @@(ctrlDef,"#decimals")
                    num_step = "1"
                    
                    if decimals > 0 { num_step = "0."+padright("",(decimals-1),"0")+"1" }

                    #$
                    div("#<wrap_attr>"="")
                    {
                        label(class="form-label #<ifstr(is_required,'fw-bold','')>" "for"="#<id>"){$"#<caption>"}
                        input(class="form-control rounded-0" type="number" name="#<name>" id="#<id>" value="#<value>" step="#<num_step>" "#<required>"="" "#<readonly>"="" "#<disabled>"="")
                    }
                    #!
                    break
                }
                case "file"
                {
                    #$
                    div("#<wrap_attr>"="")
                    {
                        label(class="form-label #<ifstr(is_required,'fw-bold','')>" "for"="#<id>"){$"#<caption>"}
                        input(class="form-control rounded-0" type="file" name="#<name>" id="#<id>" "#<required>"="" "#<readonly>"="" "#<disabled>"="")
                    }
                    #!
                    break
                }
                case "bool"
                {
                    checked = ifstr(parse.bool(value), "checked", "")
                    #$
                    div("#<wrap_attr>"="")
                    {
                        input(class="form-check-input" type="checkbox" name="#<name>" id="#<id>" "#<checked>"="" "#<required>"="" "#<readonly>"="" "#<disabled>"="")
                        label(class="form-check-label #<ifstr(is_required,'fw-bold','')>" "for"="#<id>"){$"#<caption>"}
                    }
                    #!
                    break
                }
                case "numrange"
                {
                    mincaption = field.dstr(ctrlDef,"mincaption","Min:")
                    maxcaption = field.dstr(ctrlDef,"maxcaption","Max:")
                    minname = field.dstr(ctrlDef,"minname","min")
                    maxname = field.dstr(ctrlDef,"maxname","max")
                    minid = field.dstr(ctrlDef,"minid",minname)
                    maxid = field.dstr(ctrlDef,"maxid",maxname)
                    minvalue = field.dnum(ctrlDef,"minvalue",0)
                    maxvalue = field.dnum(ctrlDef,"maxvalue",1)

                    if field.exist(parameters,minname){ minvalue = @@(parameters,"#"+minname) }
                    if field.exist(parameters,maxname){ maxvalue = @@(parameters,"#"+maxname) }

                    #$
                    div("#<wrap_attr>"="")
                    {
                        label(class="form-label #<ifstr(is_required,'fw-bold','')>" "for"="#<id>"){$"#<caption>"}
                        fieldset(class="input-group" id="#<id>" "#<disabled>"="")
                        {
                            span(class="input-group-text rounded-0"){$"#<mincaption>"}
                            input(class="form-control rounded-0" type="number" name="#<minname>" value="#<minvalue>" id="#<minid>" min="0" oninput="validInteger(this);" "#<required>"="" "#<readonly>"="")
                            span(class="input-group-text rounded-0"){$"#<maxcaption>"}
                            input(class="form-control rounded-0" type="number" name="#<maxname>" value="#<maxvalue>" id="#<maxid>" min="1" oninput="validInteger(this);" "#<required>"="" "#<readonly>"="")
                        }
                    }
                    #!
                    break
                }
                case "select"
                {
                    type = @@(ctrlDef,"$source/type") //[list, query]
                    query = @@(ctrlDef,"$source/query")
                    ref values = ifnull(@@(ctrlDef,"&source/values"),list.create())

                    if type == "query" { ref values:dbr.list(db,query,@null) }

                    new select_def
                    {
                        @"datatable*": values
                        @"id": id
                        new member "attributes"
                        {
                            @"name": name
                            @"class": "form-select rounded-0"
                        }
                        @"attr_options*": ifnull(@@(ctrlDef,"&opt_attr"),record.create())
                        @"value_field": @@(ctrlDef,"$source/keyfield")
                        @"text_field": @@(ctrlDef,"$source/showfield")
                        @"first_value": @@(ctrlDef,"$source/first_value")
                        @"first_text": @@(ctrlDef,"$source/first_text")
                        @"selected": value
                    }

                    if is_required { select_def<"attributes/required"> : "true" }
                    if is_readonly { select_def<"attributes/readonly"> : "true" }
                    if is_disabled { select_def<"attributes/disabled"> : "true" }

                    #$
                    div("#<wrap_attr>"="")
                    {
                        label(class="form-label #<ifstr(is_required,'fw-bold','')>" "for"="#<id>"){$"#<caption>"}
                        #!
                        do uie.dbSelect(select_def)
                        #!
                    }
                    break
                }
                case "inputkey"
                {
                    type = @@(ctrlDef,"$source/type") //[list, query, service]
                    query = @@(ctrlDef,"$source/query")
                    source = @@(ctrlDef,"$source/source")
                    keyfield = @@(ctrlDef,"$source/keyfield")
                    showfield = @@(ctrlDef,"$source/showfield")
                    searchfield = @@(ctrlDef,"$source/searchfield")
                    columns = @@(ctrlDef,"$source/columns")
                    ccaptions = @@(ctrlDef,"$source/ccaptions")
                    ref data = ifnull(@@(ctrlDef,"&source/value"),record.create())
                    ref values = ifnull(@@(ctrlDef,"&source/values"),list.create())

                    small_style = "
                    #input_search_container, #input_description_container,
                    #button_search_container, #button_clear_container {
                        height: calc(1.5em + .5rem + 2px) !important;
                        padding: .25rem .5rem !important;
                        font-size: .875rem !important;
                    }
                    "

                    if type == "query" { ref values:dbr.list(db,query,@null) }
                    
                    #$
                    div("#<wrap_attr>"="")
                    {
                        label(class="form-label #<ifstr(is_required,'fw-bold','')>" "for"="#<id>"){$"#<caption>"}
                        "input-key"(name="#<name>" id="#<id>" "data-key"="#<keyfield>" "data-search"="#<searchfield>" "data-text"="#<showfield>" "data-source"="#<source>" "data-value"='#<to.json(data)>' columns="#<columns>" colcaptions="#<ccaptions>" "#<ifstr(type!='service','data-source-array','')>"="#<to.json(values)>" required="#<ifstr(is_required,'true','false')>"){$""} //"control-styles"="#<small_style>"
                    }
                    #!
                    break
                }
                default
                {
                    #$
                    div("#<wrap_attr>"="")
                    {
                        label(class="form-label #<ifstr(is_required,'fw-bold','')>" "for"="#<id>"){$"#<caption>"}
                        input(class="form-control rounded-0" type="text" name="#<name>" id="#<id>" value="#<value>" "#<required>"="" "#<readonly>"="" "#<disabled>"="")
                    }
                    #!
                    break
                }
            }
        }

        #$
        script(type="text/javascript")
        {$'
            function validInteger(input) {
                input.value = input.value.replace(/[^-?0-9]/g,'');
            }
        '}
        #!
    }
}