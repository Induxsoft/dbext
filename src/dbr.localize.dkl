#include "dkli.dkh"
#!
module "Variables alojadas en la base de datos :dbr.localize"
{
    ref @dbr.localize.money_buffer=record.create()
    ref @dbr.localize.country_buffer=@null
    ref @dbr.localize.lang_buffer=@null

    @dbr.localize.default.money_code=""
    @dbr.localize.default.money_decs=2
    @dbr.localize.default.country="MEX"
    @dbr.localize.default.lang="es"
    
    country::db
    {
        if not(isnull(@dbr.localize.country_buffer)) { return @dbr.localize.country_buffer }

        new p { cod_pais:= dbr.vars.getd(db,"V12-00-001",@dbr.localize.default.country) }
        ref @dbr.localize.country_buffer=dbr.rec(db,"select sys_pk, sys_guid, codigo, codigotel, nombre, th_sep, dc_sep, iso3166, iso3166_a3 from pais where codigo=@cod_pais",p)
        
        if isnull(@dbr.localize.country_buffer) {do rise_error(510,"Código de país no encontrado: " + cod_pais) }

        return @dbr.localize.country_buffer
    }

    lang::db
    {
        if not(isnull(@dbr.localize.lang_buffer)) { return @dbr.localize.lang_buffer }

        new p { cod_pais:= dbr.vars.getd(db,"V12-00-002",@dbr.localize.default.lang) }

        ref @dbr.localize.lang_buffer=dbr.rec(db,"select sys_pk, sys_guid, nombre, iso639_1 from idioma where iso639_1=@cod_lang",p)

        if isnull(@dbr.localize.lang_buffer) { do rise_error(510,"Código de idioma no encontrado: " + cod_lang) }

        return @dbr.localize.lang_buffer
    }

    money::&db,cod_divisa
    {
        if field.exist(@dbr.localize.money_buffer,cod_divisa) { return @@(@dbr.localize.money_buffer,"&"+cod_divisa) }
        
        cod_divisa >> p
        ref m=dbr.rec(db,"select sys_pk, sys_guid, codigo, descripcion, tcambio, decimales from divisa where codigo=@cod_divisa",p)
        
        if isnull(m) { do rise_error(510,"Código de divisa no encontrado: " + cod_divisa) }

        if not(field.exist(m,"decimales")) { m<"decimales">:@dbr.localize.default.money_decs }
        if isnull(field.obj(m,"decimales")) { m<"decimales">:@dbr.localize.default.money_decs }

        @dbr.localize.money_buffer<cod_divisa+"*">: m

        return m
    }

    money_tc::&db,cod_divisa,tc
    {
        tc, cod_divisa >> p
        sql=""
        if vartype("cod_divisa")==1 
        {
            sql="update divisa set tcambio=@tc where codigo=@cod_divisa;"
            cod=dbr.str(db,"select codigo from divisa where codigo=@cod_divisa;",p)
        }
        else if vartype("cod_divisa")==2 
        {
            sql="update divisa set tcambio=@tc where sys_pk=@cod_divisa;"
            cod=cod_divisa
        }

        do dbr.execute(db,sql,p)

        if field.exist(@dbr.localize.money_buffer,cod)
        { 
            ref d=@@(@dbr.localize.money_buffer,"&"+cod) 
            d.tcambio=tc
        }
    }

    money_format::&db,cod_divisa
    {
        return "$ #,#.00"
    }

    money_decs::&db,cod_divisa
    {
        if trim(cod_divisa)=="" { return @dbr.localize.default.money_decs }
        ref m=money(db,cod_divisa)
        return m.decimales
    }

    detect_db::
    {
        ref localize_db=@null

        if isset("@crud_context") && isnull(localize_db)
        {
            if not(isnull(@@(@crud_context,"&database")))
            {
                ref localize_db=@@(@crud_context,"&database")
            }
        }

        if isset("@http_context") && isnull(localize_db)
        {
            if not(isnull(@@(@http_context,"&session/idp/database")))
            {
                ref localize_db=@@(@http_context,"&session/idp/database")
            }
        }
        return localize_db
    }

    init::&localize_db
    {
        @dbr.localize.default.money_decs=parse.num(dbr.vars.get(localize_db,"V12-0A-001"))
        @dbr.localize.default.money_code=dbr.str(localize_db,"select ifnull(codigo,'') from divisa where sys_pk=" +str(parse.num(dbr.vars.get(localize_db,"FXCA013"))),@null)
        do money(localize_db,@dbr.localize.default.money_code)
    }

    ref localize_db=detect_db()

    if not(isnull(localize_db))
    {
        do init(localize_db)
    }
}