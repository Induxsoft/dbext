#include "dkli.dkh"
#!
module "lib"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "webcl.dkh"

    function sendMessage(&config,&message)
    {
        new remplace_template
        {
            @"asunto": @@(message,"asunto")
            @"text": "Texto de prueba"
        }

        go foreach.fstr(index:i, key:k, value:v) with(remplace_template) {
            message<"message">: replace(@@(message,"message"), "@"+k, v)
        }

        new send
        {
            @"server": @@(config,"$server")
            @"port": @@(config,"$port")
            @"user": @@(config,"$user")
            @"password": @@(config,"$password")
            @"from": "Prueba <"+@@(config,"$user")+">"
            @"to": @@(message,"$to")
            @"subject": @@(message,"$subject")
            @"body": @@(message,"$message")
        }

        if @@(config,"$protocol") != "" { send<"protocol">: @@(config,"$protocol") }
        if @@(message,"$repply") != "" { send<"repply">: @@(message,"$repply") }
        if @@(message,"$cco") != "" { send<"cco">: @@(message,"$cco") }
        if @@(message,"$cc") != "" { send<"cc">: @@(message,"$cc") }

        do rise_error(0,to.json(send))

        do smtp.send(send)
    }
}