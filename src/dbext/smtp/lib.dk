#include "dkli.dkh"
#!
module ":lib"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "webcl.dkh"

    function sendMessage(&config, &message, &remplace_template)
    {
        go foreach.fstr(index:i, key:k, value:v) with(remplace_template) {
            message<"message">: replace(@@(message,"message"), "@"+k, v)
        }

        new send
        {
            @"server": @@(config,"$server")
            @"port": @@(config,"$port")
            @"user": @@(config,"$user")
            @"password": @@(config,"$password")
            @"from": @@(message,"$subject") + " <"+@@(config,"$user")+">"
            @"to": @@(message,"$to")
            @"subject": @@(message,"$subject")
            @"body": @@(message,"$message")
        }

        if @@(config,"$protocol") != "" { send<"protocol">: @@(config,"$protocol") }
        if @@(message,"$repply") != "" { send<"repply">: @@(message,"$repply") }
        if @@(message,"$cco") != "" { send<"cco">: @@(message,"$cco") }
        if @@(message,"$cc") != "" { send<"cc">: @@(message,"$cc") }

        do smtp.send(send)
    }

    ref c = @com_context
    do sendMessage(@@(c,'&config'), @@(c,'&message'), @@(c,'&replace'))
}