#include "dkli.dkh"
#!
module "form.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "../config.dk"

    do @context.begin(@crud_context)

    ref guser = @("&./")
    entity_id = @("$parameters/_entity_id")
    error = @("$error/message")
    isNew = (entity_id == "_new")
    action = replace(@DBEXT_ADD_EDIT_GUSER, "@id", entity_id)

    #$
    div(class="container mt-3")
    {
        h6{$"#<ifstr(isNew,'Agregar','Editar')> grupo de usuarios"}

        #! if trim(error) != "" { #$ h6{$"#<error>"} }
        
        form(method="POST" action="#<action>")
        {
            input(type="hidden" name="sys_pk" value="#<@@(guser, '#sys_pk')>")
            input(type="hidden" name="sys_recver" value="#<@@(guser, '#sys_recver')>")

            small{$"Nombre (ID):"}
            input(type="text" class="induxsoft-form-control mb-2" name="groupid" value="#<@@(guser, '$groupid')>" required="true")

            small{$"Descripción:"}
            input(type="text" class="induxsoft-form-control mb-2" name="description" value="#<@@(guser, '$description')>" required="true")

            small{$"Notas:"}
            textarea(name="notes" class="induxsoft-form-control mb-2"){$"#<@@(guser, '$notes')>"}

            button(class="btn btn-sm btn-secondary #<ifstr(isNew,'d-none','')>" type="button" id="btn_group_schema"){$"Esquema de seguridad"}
            button(class="btn btn-sm btn-primary" type="submit"){$"Guardar"}
            a(class="btn btn-sm btn-light" href="#<@DBEXT_USERGROUP>"){$"Cancelar"}
        }

        // MODAL ESQUEMA DE SEGURIDAD
        div(class="modal fade" id="modal_secure_schema" tabindex="-1" "aria-hidden"="true" "data-bs-backdrop"="false")
        {
            div(class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable mt-0")
            {
                div(class="modal-content induxsoft-corners p-0 border-0 shadow")
                {
                    div(class="modal-header p-3")
                    {
                        h6(class="modal-title"){$"Esquema de seguridad"}
                        button(type="button" class="btn-close btn-sm" "data-bs-dismiss"="modal" "aria-label"="Close"){$""}
                    }
                    div(class="modal-body bg-white")
                    {
                        iframe(id="_main_view" id="mdl_ss_content" src="" style="width:100%; height: 70vh;"){$""}
                    }
                }
            }
        }

        script(src="#<@JS_MAIN>"){$""}
        script(src="#<@JS_USERGROUP>"){$""}
        script{$'
            usergroup.guser = #<to.json(guser)>;
            usergroup.url_profile = "#<@DBEXT_ADD_EDIT_PROFL>";
        '}
    }
}