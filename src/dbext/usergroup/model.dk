#include "dkli.dkh"
#!
module "model"
{
    #include "../config.dk"
    #include "../_lib/lib.dk"

    @table_name = "usergroup"

    function usergroup_create(&db,&params,&data)
    {
        ref res = entity.create(db,params,data)
        return res
        
        exception
        {
            do cu_error("grupo de usuario")
            do rise_error(last_error_code(), last_error())
        }
    }

    function create(&db,&params,&data)
    {
        @use_transaction = @false

        do dbr.apps.action.pre("XB71")
        do dbr.begin(db)

        ref result = usergroup_create(db,params,data)

        do dbr.apps.action.pos(result)
        do dbr.commit(db)
        do dbr.apps.action.ext(result)

        return result

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db){ do dbr.rollback(db) }
            do dbr.apps.action.log()
            do rise_error(last_error_code(),last_error())
        }
    }

    function update(&db,&params,&data)
    {
        @use_transaction = @false

        do dbr.apps.action.pre("XB72")
        do dbr.begin(db)

        ref result = usergroup_create(db,params,data)

        do dbr.apps.action.pos(result)
        do dbr.commit(db)
        do dbr.apps.action.ext(result)

        return result

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db){ do dbr.rollback(db) }
            do dbr.apps.action.log()
            do rise_error(last_error_code(),last_error())
        }
    }

    function usergroup_delete(&db, &params)
    {
        @use_transaction = @false

        do dbr.apps.action.pre("XB73")
        do dbr.begin(db)

        ref entity = @null
        deleted = @false

        do dbr.execute(db, "DELETE FROM profile WHERE usergroup=@_entity_id;", params)
        do dbr.execute(db, "DELETE FROM user_usergroup_ WHERE groups=@_entity_id;", params)
        
        codeblock "Intentar eliminación física"
        {
            do entity.delete(db,params)
            deleted = @true
            exception{ do pop_exception() }
        }
        if not(deleted)
        {
            sql = "
            UPDATE usergroup SET
                sys_deleted = 1,
                sys_info = groupid,
                groupid = CONCAT('~',sys_pk)
            WHERE sys_pk = @_entity_id
            "
            do dbr.execute(db,sql,params)
            ref entity:entity.read(db,params)
        }

        do dbr.apps.action.pos(entity)
        do dbr.commit(db)
        do dbr.apps.action.ext(entity)

        return @true
        
        excepcion
        {
            do errordet(@false)
            if dbr.in_transaction(db) { do dbr.rollback(db) }
            do dbr.apps.action.log()
            do rise_error(500, last_error())
        }
    }

    function list(&db, &params)
    {
        do dbr.apps.action.grant("XB70")

        query = "
        SELECT
            sys_pk,
            groupid,
            description,
            notes
        FROM usergroup
        WHERE
            NOT IFNULL(sys_deleted,0)
            AND IF(IFNULL(@s,'')='', TRUE, (groupid = @s OR description LIKE CONCAT('%',@s,'%')))
        ORDER BY groupid
        LIMIT #<@default_max_rows>;
        "
        return dbr.list(db, ftext(query), params)

        exception
        {
            do errordet(@false)
            do dbr.apps.action.log()
            do rise_error(last_error_code(),last_error())
        }
    }

    function read(&db,&params)
    {
        do dbr.apps.action.grant("XB70")

        return entity.read(db,params)

        exception
        {
            do errordet(@false)
            do dbr.apps.action.log()
            do rise_error(last_error_code(),last_error())
        }
    }

    function cu_error(table)
    {
        new fields {
            @"groupid": "El nombre"
        }
        do valide_duplicate(fields, table, last_error(), last_error_code())
    }

    point @create to create //usergroup_create
    point @update to update //usergroup_create
    point @delete to usergroup_delete
    point @list to list
    point @read to read
}