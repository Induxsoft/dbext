#include "dkli.dkh"
#!
module "model"
{
    #include "dbr.auths.dkl"
    @table_name = "sys_auth_tpy"

     @list_query="SELECT t.*,u.description descgrupo,tu.username usuariomaster,if(IFNULL(t.autologin,0),'Sí','No')flogin
     FROM sys_auth_tpy t 
     INNER JOIN usergroup u ON t.usergroup=u.sys_pk
     LEFT JOIN tuser tu ON t.masteruser=tu.sys_pk 
     where ifnull(t.sys_deleted,0)=0
     order by t.sys_pk desc"

     prepareView::&db,&params,&rec
     {
          if isnull(rec){return}
          rec<"grupos*">:dbr.list(db,"select * from usergroup ",params)
          params<"user">:@@(rec,"#masteruser")
          rec<"user*">:dbr.rec(db,"select * from tuser where sys_pk=@user",params)
          rec<"users*">:dbr.list(db,"select * from tuser",params)
     }
     list::&db,&params
     {
          // if not(dbr.security.isauth(db,@AUT_ACCESS_TIPO_AUTORIZACIONES)) { do rise_error(500,"No autorizado") }
          do dbr.apps.action.grant("XB20")

          ref entity= entity.list(db,params)
          return entity

          exception
          {
               do errordet(@false)
               do dbr.apps.action.log()
               do rise_error(last_error_code(),last_error())
          }
     }
   
     read::&db,&params
     {
          // if not(dbr.security.isauth(db,@AUT_READ_TIPO_AUTORIZACION)) { do rise_error(500,"No autorizado") }
          do dbr.apps.action.grant("XB20")

          ref entity= entity.read(db,params)
          do prepareView(db,params,entity)
          return entity

          exception
          {
               do errordet(@false)
               do dbr.apps.action.log()
               do rise_error(last_error_code(),last_error())
          }
     }
     blank::&db,&params
     {
          do dbr.apps.action.grant("XB20")
          new entity{}
          do prepareView(db,params,entity)
          return entity

          exception
          {
               do errordet(@false)
               do dbr.apps.action.log()
               do rise_error(last_error_code(),last_error())
          }
     }
     save::&db,&params,&data
     {
          // if not(dbr.security.isauth(db,@AUT_CREATE_TIPO_AUTORIZACION)) { do rise_error(500,"No autorizado") }
          // if not(dbr.security.isauth(db,@AUT_UPDATE_TIPO_AUTORIZACION)) { do rise_error(500,"No autorizado") }

          data<"autologin">:if(parse.bool(@@(data,"autologin")),1,0)
          if @@(data,"#min_users")<1{data<"min_users">:1}
          if @@(data,"$masteruser")==""{data<"masteruser*">:@null}

          ref datatpy=dbr.rec(db,"select * from sys_auth_tpy where sys_pk=@_entity_id",params)
          if not(isnull(datatpy)){data<"id">:@@(datatpy,"id")}
          
          ref entity=dbr.auths.type.register(db,data)
     
          return entity

          exception
          {
               error=last_error()
               do prepareView(db,params,data)
               do rise_error(500,error)
          }
     }

     create::&db,&params,&data
     {
          @use_transaction = @false

          do dbr.apps.action.pre("XB21")
          do dbr.begin(db)

          ref result = save(db,params,data)

          do dbr.apps.action.pos(result)
          do dbr.commit(db)
          do dbr.apps.action.ext(result)

          return result

          exception
          {
               do errordet(@false)
               if dbr.in_transaction(db){ do dbr.rollback(db) }
               do dbr.apps.action.log()
               do rise_error(last_error_code(),last_error())
          }
     }

     update::&db,&params,&data
     {
          @use_transaction = @false

          do dbr.apps.action.pre("XB22")
          do dbr.begin(db)

          ref result = save(db,params,data)

          do dbr.apps.action.pos(result)
          do dbr.commit(db)
          do dbr.apps.action.ext(result)

          return result

          exception
          {
               do errordet(@false)
               if dbr.in_transaction(db){ do dbr.rollback(db) }
               do dbr.apps.action.log()
               do rise_error(last_error_code(),last_error())
          }
     }

     delete::&db,&params
     {
          @use_transaction = @false
          // if not(dbr.security.isauth(db,@AUT_DELETE_TIPO_AUTORIZACION)) { do rise_error(500,"No autorizado") }

          do dbr.apps.action.pre("XB23")
          do dbr.begin(db)

          ref data=dbr.rec(db,"select * from sys_auth_tpy where sys_pk=@_entity_id",params)
          if isnull(data){do rise_error(500,"No se encontró datos")}
          do dbr.auths.type.unregister(db,@@(data,"$id"))

          do dbr.apps.action.pos(data)
          do dbr.commit(db)
          do dbr.apps.action.ext(data)

          return @null

          exception
          {
               do errordet(@false)
               if dbr.in_transaction(db){ do dbr.rollback(db) }
               do dbr.apps.action.log()
               do rise_error(last_error_code(),last_error())
          }
     }
   
     point @delete to delete
     point @create to create
     point @update to update
     point @blank to blank
     point @read to read
     point @list to list
}