#include "dkli.dkh"
#!
module "form.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "../config.dk"

    do @context.begin(@crud_context)
    ref @http_context=@("&http")
    ref autorizaciones=@("&./autorizaciones")
    // do file.wtext("C:\\Users\\Dev\\Documents\\devkrons\\devkronNet\\dbext\\t.json",to.json(@http_context))

    ref data = @("&./")
    entity_id = @("$parameters/_entity_id")
    error = @("$error/message")
    isNew = (entity_id == "_new")
    action = replace(@TYPE_AUTH_BOX_ADD_EDIT, "@id", entity_id)

    #$
    div(class="container")
    {   
        script(src="#<@JS_AUTHBOX>"){""}
        link(href="#<@CSS_MAIN>" rel="stylesheet"){""}
        form(method="POST" action="#<action>" id="form")
        {
            div(id="main_bar" class="row container-section my-2 px-0 py-2 border-bottom")
            {
                div(class="col-4 d-flex align-items-center p-0")
                {
                    h5(class="tex-no-break m-0"){$"Tipo de solicitud de autorización"}
                }
                div(class="col-8 d-flex align-items-center justify-content-end p-0 gap-2")
                {
                    a(href="./" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" title="Refrescar"){$"#<@@(@icons,'ARROW_CLOCKWISE')>"}
                    button(type="submit" class="btn btn-sm border-secondary induxsoft-corners btn-main-action"){
                        $'#<@@(@icons,"save2")>'
                    }
                    a(class="btn btn-sm border-secondary induxsoft-corners btn-main-action" href="#<@TYPE_AUTH_BOX>") {
                        svg(xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-lg" viewBox="0 0 16 16") {
                            path(d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z")
                        }
                    }
                }
            }
            div(class="#<ifstr(@('error/message')!='','alert alert-danger','')>"){$"#<@('error/message')>"}
            input(type="hidden" value="#<@('#./sys_recver')>" name="sys_recver")
            #$
            div(class="row")
            {""
                div(class="col-md-2")
                {
                    label{"ID:"}
                    input(class="induxsoft-form-control" "#<ifstr(@('#./sys_pk')!=0,'disabled','')>"="true" name="id" value="#<@('$./id')>" required="true" maxlength="32")
                }
                
                div(class="col-md-3")
                {
                    label{"Grupo:"}
                    select(class="induxsoft-form-select" name="usergroup" value="#<@('$./usergroup')>"  required="true")
                    {""
                        #!
                        for i = 0; i < @count(@("&./grupos"))
                        {
                            ref g=@item(@("&./grupos"),i)
                            #$ option(value="#<@@(g,'sys_pk')>" "#<ifstr(@('#./usergroup')==@@(g,'#sys_pk'),'selected','')>"="true"){"#<@@(g,'description')>"}
                        }
                        #$
                    }
                }
                div(class="col-md-3")
                {
                    label{"Min. de usuario:"}
                    input(type="Number" min="1" class="induxsoft-form-control" name="min_users" value="#<@('$./min_users')>"  required="true")
                }
                div(class="col-md-4")
                {
                    label{"Usuario maestro:"}
                    select(class="induxsoft-form-select" name="masteruser")
                    {
                        option(value=""){"Ninguno"}
                         #!
                        for i = 0; i < @count(@("&./users"))
                        {
                            ref u=@item(@("&./users"),i)
                            #$ option(value="#<@@(u,'sys_pk')>" "#<ifstr(@('#./masteruser')==@@(u,'#sys_pk'),'selected','')>"="true"){"#<@@(u,'username')>"}
                        }
                        #$
                    }
                }
                
            }
            div(class="row")
            {
                div(class="col-md-6")
                {
                    label{"Texto:"}
                    input(class="induxsoft-form-control" name="text"  maxlength="50" value="#<@('$./text')>")
                }
                div(class="col-md-2 mt-2 d-flex align-items-center")
                {
                    label{input(type="checkbox" name="autologin" "#<ifstr(@('#./autologin'),'checked','')>"="true")" Auto login"}
                }
            }
            div(class="col-md-12")
            {
                label{"View:"}
                textarea(class="induxsoft-form-control" name="view"  required="true" ){"#<@('$./view')>"}
            }
            
        }

    }
}