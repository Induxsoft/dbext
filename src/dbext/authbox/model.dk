#include "dkli.dkh"
#!
module "model"
{
    #include "dbr.auths.dkl"
    @table_name = "sys_auth_log"

    filter="
        if(ifnull(@s,'')='p1' or ifnull(@s,'')='',ifnull(l.authorized,0)=0 and ifnull(l.rejected,0)=0 and ifnull(l.cancel,0)=0 and ifnull(l.error,0)=0,true)and 
        if(ifnull(@s,'')='a1',ifnull(l.authorized,0)=1, true)and 
        if(ifnull(@s,'')='r1',ifnull(l.rejected,0)=1 ,true)and 
        if(ifnull(@s,'')='c1',ifnull(l.cancel,0)=1 ,true)and 
        if(ifnull(@s,'')='e1',ifnull(l.error,0)=1, true)
    "
    @list_query = "select l.*,t.id,t.text,t.`view`,t.min_users,if(ifnull(t.autologin,0),'Sí','No')fautologin,u.description descugroup,
    tu.username umaster ,tu2.username solicitante,date_format(l.sys_dtcreated,'%Y-%m-%d')solicitud,date_format(l.sys_timestamp,'%Y-%m-%d %h:%i:%s')fhop,
    ifnull(l.authorized,0)autorizado,ifnull(l.rejected,0)rechazado,ifnull(l.cancel,0)cancelado,ifnull(l.error,0)error
    from sys_auth_log l 
    inner join sys_auth_tpy t on l.tpy=t.sys_pk
    inner JOIN usergroup u on t.usergroup=u.sys_pk
    INNER JOIN user_usergroup_ ug ON u.sys_pk=ug.groups
    LEFT JOIN tuser tu ON t.masteruser=tu.sys_pk
    LEFT JOIN tuser tu2 on l.req_user=tu2.sys_pk
    where ug.users=@user and "+filter+"
    limit 200"

    @read_query="select l.*,t.id,t.text,t.`view`,t.min_users,if(ifnull(t.autologin,0),'Sí','No')fautologin,
    ifnull(l.authorized,0)autorizado,ifnull(l.rejected,0)rechazado,ifnull(l.cancel,0)cancelado,ifnull(l.error,0)error,
    tu3.username userrej,
    tu2.username solicitante,date_format(l.sys_dtcreated,'%Y-%m-%d')solicitud,
    (
        case
            when ifnull(l.authorized,0) then 'Autorizado'
            when ifnull(l.rejected,0) then 'Rechazado'
            when ifnull(l.cancel,0) then 'Cancelado'
            when ifnull(l.error,0) then 'Error'
            else 'Pendiente'
        end
    )estado
    from sys_auth_log l 
    inner join sys_auth_tpy t on l.tpy=t.sys_pk 
    LEFT JOIN tuser tu2 on l.req_user=tu2.sys_pk
    LEFT JOIN tuser tu3 on l.rejby=tu3.sys_pk
    where l.#<@keyfield>=@_entity_id limit 1"

   list::&db,&params
   {
        ref user=dbr.auths.getUser(db)
        params<"user">:@@(user,"#sys_pk")

        ref entity= entity.list(db,params)
        return entity
   }
   update::&db,&params,&data
   {
        if field.exist(data,"act")
        {
            ref auth_log=@null
            switch @@(data,"#act")
            {
                case 1{ref auth_log= dbr.auths.auth(db,@@(data,"$uuid"),@@(data,"$notas"))}
                case 2{ref auth_log= dbr.auths.deny(db,@@(data,"$uuid"),@@(data,"$notas"))}
                case 3{ref auth_log= dbr.auths.cancel(db,@@(data,"$uuid"),@@(data,"$notas"))}
            }
            if trim(@@(auth_log,"$error"))!=""{do rise_error(500,@@(auth_log,"$error"))}
            return data
        }
        ref entity= entity.update(db,params,data)
        return entity
   }
   read::&db,&params
   {
        ref entity= entity.read(db,params)
        entity<"autorizaciones*">:dbr.list(db,"SELECT l.*,u.userid,u.username,date_format(l.sys_dtcreated,'%Y-%m-%d')autorizacion,
        (
            case
                when ifnull(l.authorized,0) then 'Autorizado'
                when ifnull(l.rejected,0) then 'Rechazado'
                when ifnull(l.cancel,0) then 'Cancelado'
            end
        )estado
        FROM sys_auth_log_usr l
        INNER JOIN tuser u on l.auth_user=u.sys_pk where l.log=@_entity_id",params)
        return entity
   }
   
   point @read to read
   point @create to update
   point @list to list

}