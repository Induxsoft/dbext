#include "dkli.dkh"
#!
module "form.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "../config.dk"

    do @context.begin(@crud_context)
    ref @http_context=@("&http")
    ref autorizaciones=@("&./autorizaciones")
    // do file.wtext("C:\\Users\\Dev\\Documents\\devkrons\\devkronNet\\dbext\\t.json",to.json(@http_context))

    ref data = @("&./")
    entity_id = @("$parameters/_entity_id")
    error = @("$error/message")
    isNew = (entity_id == "_new")
    action = replace(@AUTH_BOX_ADD_EDIT, "@id", entity_id)

    response=ifstr(@("$./http_response")!="",@("$./http_response"),"{}")
    request=ifstr(@("$./http_request")!="",@("$./http_request"),"{}")
    new @auth_context
    {
        @"database":@("&database")
        @"request*":record.copy(from.json(request),"*")
        @"response*":record.copy(from.json(response),"*")
        @"error_info": @("$./error_info")
        @"error":@("#./error")
    }

    view=@('$./view')

    if trim(view)!=""{res=runcode(view,'auth_context',@auth_context)}
    else{ res=@("$./http_request")}

    pendiente=@false 
    if not(@("#./autorizado")) && not(@("#./rechazado")) && not(@("#./cancelado")) && not(@("#./error")){pendiente=@true}
    #$
    div(class="container")
    {   
        script(src="#<@JS_AUTHBOX>"){""}
        link(href="#<@CSS_MAIN>" rel="stylesheet"){""}
        form(method="POST" action="#<action>" id="form")
        {
            div(id="main_bar" class="row container-section my-2 px-0 py-2 border-bottom")
            {
                div(class="col-4 d-flex align-items-center p-0")
                {
                    h5(class="tex-no-break m-0"){$"Solicitud de autorización"}
                }
                div(class="col-8 d-flex align-items-center justify-content-end p-0 gap-2")
                {
                    a(href="./" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" title="Refrescar"){$"#<@@(@icons,'ARROW_CLOCKWISE')>"}
                    // button(type="submit" class="btn btn-sm border-secondary induxsoft-corners btn-main-action"){
                    //     $'#<@@(@icons,"save2")>'
                    // }
                    a(class="btn btn-sm border-secondary induxsoft-corners btn-main-action" href="#<@AUTH_BOX>") {
                        svg(xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-lg" viewBox="0 0 16 16") {
                            path(d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z")
                        }
                    }
                }
            }
            
            #$
            div(class="d-flex pack-d-block-sm")
            {
                div
                {
                    h6(class="fw-bold"){$"#<@('$./text')+' '+@('$./transid')+' '+@('$./operation')>"}
                    small{"#<@('$./solicitante')+' ['+@('$./solicitud')+']'>"}
                }
                span(class="flex-grow-1"){""}
                #!
                if not(pendiente)
                {
                    #$
                    div(class="pack-control-sm-w-100")
                    {
                        h6(class="text-end fw-bold"){"#<@('$./estado')>"}
                        #!
                        if @("#./error"){#$ small(class="fw-bold"){"#<@('$./error_info')>"}}
                        #! if @("#./rechazado"){#$ small{"#<@('$./userrej')>"}}
                    }
                }
                #$
            }
            #!
            if pendiente
            {
                #$
                label(class="fw-bold"){"Nota:"}
                textarea(class="induxsoft-form-control" id="text_notas" placeholder="Notas para Autorizar,Rechazar y Cancelar" style="resize:none"){""}
                div(class="d-flex pack-d-block-sm")
                {""
                    span(class="flex-grow-1"){""}
                    div
                    {
                        
                        button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action m-1" onclick="auth.action(1,'#<@('$./sys_guid')>')"){"Autorizar"}
                        button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action m-1" onclick="auth.action(2,'#<@('$./sys_guid')>')"){"Rechazar"}
                        button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action m-1" onclick="auth.action(3,'#<@('$./sys_guid')>')"){"Cancelar"}
                    }
                }
            }
            
            #!
            if @count(autorizaciones)>0
            {
                #$
                div(style="max-height:20vh;overflow: auto;")
                {
                #$
                    table(class="table")
                    {
                        thead
                        {
                            tr
                            {
                                // th{"User id"}
                                th{"Usuario"}
                                th{"Estado"}
                                th{"Fecha"}
                                th{"Notas"}
                            }
                        }
                        
                        tbody
                        {
                            #!
                            for i = 0; i < @count(autorizaciones)
                            {
                                ref a=@item(autorizaciones,i)

                                #$
                                tr
                                {
                                    // td{"#<@@(a,'$userid')>"}
                                    td{"#<@@(a,'$username')>"}
                                    td{"#<@@(a,'$estado')>"}
                                    td{"#<@@(a,'$autorizacion')>"}
                                    td{"#<@@(a,'$note')>"}
                                }
                            }
                            #$
                        }
                    }
                    
                }
            }
            
            h5{"Datos de la solicitud"}
            div(style="max-height:70vh;overflow: auto;")
            {
                div
                {
                    $"#<res>"
                }
            }
            
        }

    }
}