#include "dkli.dkh"
#!
module "list"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "../config.dk"
    #include "../_lib/scape_special_charactes2.dk"

    do @context.begin(@crud_context)

    ref data = @("&./")
    
    filter=@("$parameters/s")
    #$
    div(class="container p-0")
    {
        script(src="#<@JS_AUTHBOX>"){""}
        div(id="main_bar" class="row container-section my-2 px-0 py-2 border-bottom")
        {
            div(class="col-4 d-flex align-items-center p-0")
            {
                h5(class="tex-no-break m-0"){$"Solicitudes de autorización"}
            }
            div(class="col-8 d-flex align-items-center justify-content-end p-0 gap-2")
            {
                // a(href="#<replace(@AUTH_BOX_ADD_EDIT, '@id', '_new')>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print"){$"Agregar"}
                button(class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" title="Imprimir" onclick="window.print()"){$"#<@@(@icons,'PRINTER')>"}
                a(href="./" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" title="Refrescar"){$"#<@@(@icons,'ARROW_CLOCKWISE')>"}
                a(href="/" target="_top" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" title="Salir"){$"#<@@(@icons,'X')>"}
            }
        }
        div(id="work_area" class="container-section pt-2")
        {
            form(action="./" method="GET" id="form_search" class="no-print my-1")
            {
                div(class="row")
                {
                    div(class="col-md-6"){""}
                    div(class="col-md-6")
                    {
                        select(class="induxsoft-form-select " name="s" id="select_filter")
                        {
                            option(value="p1" "#<ifstr(filter=='p1','selected','')>"="true"){"Pendientes"}
                            option(value="a1" "#<ifstr(filter=='a1','selected','')>"="true"){"Autorizadas"}
                            option(value="r1" "#<ifstr(filter=='r1','selected','')>"="true"){"Rechazadas"}
                            option(value="c1" "#<ifstr(filter=='c1','selected','')>"="true"){"Canceladas"}
                            option(value="e1" "#<ifstr(filter=='e1','selected','')>"="true"){"Error"}
                        }
                    }
                }
            }
            div
            {
                #! lenght = list.count(data)
                if lenght <= 0
                {
                    message = ""
                    if @@(@crud_context,"$parameters/s") == "" { message = "Sin registros." }
                    else  { message = "Sin resultados." }

                    #$ div(class="text-center")
                    {
                        h6(style="background-color: #F5F5F5; padding: 10rem 0;"){"#<message>"}
                    }
                }
                #! else 
                {
                    #$ div(style="overflow-y:auto;max-height: 75vh;" class="mb-2" id="list_table_container")
                    {
                        table(class="table")
                        {
                            thead
                            {
                                tr
                                {
                                    th(class="h6"){$"Transacción"}
                                    th(class="h6"){$"Operación"}
                                    th(class="h6"){$"ID"}
                                    th(class="h6"){$"Solicitud"}
                                    th(class="h6"){$"Solicitante"}

                                    //rechazo
                                    #!
                                    if filter!="" && filter!="p1" && filter!="a1"
                                    {
                                        text="rechazado"
                                        if filter=="c1"{text="cancelado"}
                                        else if filter=="e1"{text="del error"}
                                        #$
                                        th(class="h6"){$"Fecha #<text>"}
                                    }
                                    #$
                                    
                                    th(class="h6"){$"Notas"}
                                    th(class="h6 text-center no-print"){$"Acciones"}
                                }
                            }
                            tbody
                            {
                                $""
                                #! for i = 0; i < list.count(data)
                                {
                                    ref dt = list.obj(data, i)
                                    pendiente=@false 
                                    if not(@@(dt,"#autorizado")) && not(@@(dt,"#rechazado")) && not(@@(dt,"#cancelado")) && not(@@(dt,"#error")){pendiente=@true}
                                    #$ tr
                                    {
                                        // 
                                        td{$"#<@@(dt,'$text')>"}
                                        td{$"#<@@(dt,'$operation')>"}
                                        td{$"#<@@(dt,'$transid')>"}
                                        td{$"#<@@(dt,'$solicitud')>"}
                                        td{$"#<@@(dt,'$solicitante')>"}
                                        
                                        #!
                                        if filter!="" && filter!="p1" && filter!="a1"
                                        {
                                            #$
                                            td{$"#<@@(dt,'$fhop')>"}
                                        }
                                        
                                        td{$"#<@@(dt,'$note')>"}
                                        td(class="no-print")
                                        {
                                            div(class="d-flex gap-2 justify-content-center")
                                            {
                                                a(href="#<replace(@AUTH_BOX_ADD_EDIT, '@id', @@(dt,'sys_pk'))>" class="btn btn-sm btn-light"){$"Ver"}
                                                // button(class="btn btn-sm btn-light" onclick="InduxsoftCrudlModel.Delete(#<@@(dt,'sys_pk')>)"){$"Eliminar"}
                                                #!
                                                if pendiente
                                                {
                                                    #$
                                                    button(type="button" class="btn btn-sm btn-light induxsoft-corners btn-main-action m-1" onclick="auth.action(1,'#<@@(dt,'$sys_guid')>')"){"Autorizar"}
                                                    button(type="button" class="btn btn-sm btn-light induxsoft-corners btn-main-action m-1" onclick="auth.action(2,'#<@@(dt,'$sys_guid')>')"){"Rechazar"}
                                                    button(type="button" class="btn btn-sm btn-light induxsoft-corners btn-main-action m-1" onclick="auth.action(3,'#<@@(dt,'$sys_guid')>')"){"Cancelar"}
                                                }
                                                #$
                                            }
                                        }
                                    }
                                } 
                            }
                        }
                    }
                }
            }
        }
       
    }
}