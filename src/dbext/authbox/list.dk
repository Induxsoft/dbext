#include "dkli.dkh"
#!
module "list"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "../config.dk"
    #include "../_lib/scape_special_charactes2.dk"
    #include "dbr.auths.dkl"
    #include "dbr.dkh"
    #include "uielements.v12.dkl"

    do @context.begin(@crud_context)
    ref @http_context=@("&http")
    ref data = @("&./")
    
    filter=@("$parameters/s")

    // ref ps=dbr.auths.post(@("&database"),"contrato","000001","update",@http_context,@null)
    #$
    div(class="container p-0")
    {
        script(src="#<@JS_AUTHBOX>"){""}
        div(id="main_bar" class="row container-section my-2 px-0 py-2 border-bottom")
        {
            div(class="col-4 d-flex align-items-center p-0")
            {
                h5(class="tex-no-break m-0"){$"Solicitudes de autorización"}
            }
            div(class="col-8 d-flex align-items-center justify-content-end p-0 gap-2")
            {
                // a(href="#<replace(@AUTH_BOX_ADD_EDIT, '@id', '_new')>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print"){$"Agregar"}
                button(class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" title="Imprimir" onclick="window.print()"){$"#<@@(@icons,'PRINTER')>"}
                a(href="./" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" title="Refrescar"){$"#<@@(@icons,'ARROW_CLOCKWISE')>"}
                a(href="/" target="_top" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" title="Salir"){$"#<@@(@icons,'X')>"}
            }
        }
        div(id="work_area" class="container-section pt-2")
        {
            form(action="./" method="GET" id="form_search" class="no-print my-1")
            {
                div(class="row")
                {
                    div(class="col-md-6"){""}
                    div(class="col-md-6")
                    {
                        select(class="induxsoft-form-select " name="s" id="select_filter")
                        {
                            option(value="p1" "#<ifstr(filter=='p1','selected','')>"="true"){"Pendientes"}
                            option(value="a1" "#<ifstr(filter=='a1','selected','')>"="true"){"Autorizadas"}
                            option(value="r1" "#<ifstr(filter=='r1','selected','')>"="true"){"Rechazadas"}
                            option(value="c1" "#<ifstr(filter=='c1','selected','')>"="true"){"Canceladas"}
                            option(value="e1" "#<ifstr(filter=='e1','selected','')>"="true"){"Error"}
                        }
                    }
                }
            }
            div
            {
                #!
                new table
                {
                    @"datatable*":data
                    member @"columns"
                    {
                        member @"text"{@"caption":"Transacción"}
                        member @"operation"{@"caption":"Operación"}
                        member @"transid"{@"caption":"ID"}
                        member @"solicitud"{@"caption":"Solicitud"}
                        member @"solicitante"{@"caption":"Solicitante"}
                        if filter!="" && filter!="p1" && filter!="a1"
                        {
                            text="rechazado"
                            if filter=="c1"{text="cancelado"}
                            else if filter=="e1"{text="del error"}
                            member @"fhop"{@"caption":"Fecha "+text}
                        }
                        member @"note"{@"caption":"Notas"}                        
                        member @"_actions"
                        {
                            @"caption":"Acciones"
                            @"no-print":@true
                            @"template":ftext('
                                <div class="d-flex gap-2 justify-content-center">
                                    <a href="#<@AUTH_BOX>${DataRow.sys_pk}/" class="btn btn-sm btn-light">Ver</a>
                                    
                                </div>
                            ')
                        }


                    }
                }

                
                  //<button type="button" class="btn btn-sm btn-light induxsoft-corners btn-main-action m-1" onclick="auth.action(1,\'${DataRow.sys_guid}\')">Autorizar</button>
                                   //// <button type="button" class="btn btn-sm btn-light induxsoft-corners btn-main-action m-1" onclick="auth.action(2,\'${DataRow.sys_guid}\')">Rechazar</button>
                                   // <button type="button" class="btn btn-sm btn-light induxsoft-corners btn-main-action m-1" onclick="auth.action(3,\'${DataRow.sys_guid}\')">Cancelar</button>
                do uie.dbeditable(table,"tbl_solicitudes")
                #$
            }
        }
       
    }
}