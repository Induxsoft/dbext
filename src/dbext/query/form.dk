#include "dkli.dkh"
#!
module "form.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "uielements.v12.dkl"
    #include "dbr.controls.dkl"
    #include "dbext/_lib/lib.dk"

    do @context.begin(@crud_context)

    ref @properties = ifnull(@("&./properties"),record.create())
    ref @controls = ifnull(@("&./controls"),record.create())
    ref @design = ifnull(@("&./design"),record.create())
    ref @titles = ifnull(@("&./titles"),record.create())
    // ref data = ifnull(@("&./data"),list.create())

    @titulo = @("$./title")

    url_exit_encode=trim(@("$parameters/_from_url_e"))
    url_exit=trim(@("$parameters/---from_ur"))

    title_encode=trim(@("$parameters/title_encode"))
    title=trim(@("$parameters/title"))

    @layout = ifempty(@@(@properties,"$layout"), "document")

    function print_work_area()
    {
        #$
        // Contenido principal
        section(class="bg-white p-1" id="work_area")
        {
            div(class="printable-element #<ifstr(@layout=='view','show-on-print','')>")
            {
                p(class="text-center mb-0"){$"#<@@(@titles,'$title')>"}
                p(class="text-center mb-0"){$"#<@@(@titles,'$subtitle')>"}
                p(class="text-center mb-0"){$"#<@@(@titles,'$subtitle_2')>"}

                div(class="row")
                {
                    div(class="col-3")
                    {
                        small(class="d-block"){ $"#<cut(@('$http/session/user/name'),25)>" }
                        small(class="d-block"){ b{$"Impresión: "} $"#<date_str(now(),'dd/MMM/yyyy')>" }
                    }
                    div(class="col-6")
                    {
                        h5(class="text-center"){$"#<@titulo>"}
                    }
                    div(class="col-3 text-end"){$""}
                }
            }
            
            #!
            do uie.dbTable(@design)
            #$

            // div(class="#<ifstr(@layout=='view','show-on-print','')>"){p(class="fixed-bottom text-center my-1"){$"#<@@(@titles,'$footer')>"}}
        }
        #!
    }

    function before_cell(&params,&row,&cell)
    {
        /**
        * params = Parámetros de la table
        * row = Datos de la fila
        * cell = Información de la celda
        */

        cname = @@(cell,"$column")
        ref column = @@(params,"&columns/"+cname)
        
        if not(field.exist(cell,"attributes")){ cell<"attributes*"> : ifnull(@@(column,"&attributes"),record.create()) }
        if not(isanyword(@@(column,"$summary"),"sum,max,min,avg,count")) { do field.remove(column,"summary") }
        if not(parse.bool(@@(column,"$visible"))) {
            cell<"_abort"> : @true
            cell<"attributes/hidden"> : ""
            return
        }
        href = trim(@@(column,"$anchor/href"))
        if href != "" && @@(cell,"$element") != "th" {
            field = ifempty(@@(cell,"$field"),@@(cell,"$text"))
            textContent = @@(row,field)
            exclude_empty = parse.bool(field.dstr(column,"anchor/pmtrs-exc-empty","false"))
            exclude_zeros = parse.bool(field.dstr(column,"anchor/pmtrs-exc-zeros","false"))

            go foreach.fstr(key:key, value:value) with(row)
            {
                if vartype('value') != 3 && contains(href,"@"+key) {
                    if exclude_empty && value=="" || exclude_zeros && str(value)=="0" { return }
                    href = replace(href,"@"+key,value)
                }
            }
            cell<"text"> : ftext('<a href="#<href>">#<textContent></a>')
        }
    }

    function after_cell(&params,&row,&cell)
    {
        cname = @@(cell,"$column")
        ref column = @@(params,"&columns/"+cname)

        // code...
    }

    point bf_cell to before_cell
    point af_cell to after_cell

    using @design
    {
        @"before_cell*": bf_cell
        // @"after_cell*": af_cell
    }

    if title_encode!=""{@titulo=url_dcode(title_encode)}
    else if title!=""{@titulo=title}

    if url_exit_encode!=""{url=url_dcode(url_exit_encode)}
    else if url_exit!=""{url=url_exit}
    else{url="../"}

    new nav_config
    {
        @"title": @titulo
        @"urlexit":url
    }

    #$
    div(class="v12-list-view #<ifstr(@layout=='view','container-fluid','container-lg')>" id="view")
    {
        // style
        // {$'
        //     tr th { font-size:.9rem; outline:none; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; -o-text-overflow:ellipsis; }
        //     tr td { font-size:.8rem; }
        // '}
        
        // Filtros y acciones
        section(class="bg-white" id="top_area")
        {
            #!
            do uie.printV12FormBar(nav_config)
            #$

            form(class="" action="./" method="GET" id="form-filter")
            {
                div(class="row gx-2")
                {$""
                    #!
                    do dbr.control.GenerateHtml(@("&database"),@controls)
                    
                    if list.count(list.create_from_fields(@controls)) > 0
                    {
                        #$
                        div(class="col-auto align-self-end") {
                            button(class="btn btn-primary rounded-0" type="submit" id="btn-filter"){$"Aplicar"}
                        }
                    }
                    #$
                }
            }
        }

        #!
        if @layout == "document" {#$
            div(class="bg-light w-100 p-2" style="max-height:80vh; overflow-y:auto;") {
            div(class="" style="min-width:100%; width:fit-content; box-shadow: inset 0 -3em 3em rgba(0, 0, 0, 0.1), 0.3em 0.3em 1em rgba(0, 0, 0, 0.3);") {
                #!
                do print_work_area()
                #$
            }}
        }
        #!
        else { do print_work_area() }
        #$

        // Resúmenes y datos al pie
        section(id="bottom_area")
        {
            //////////////////////////////////////////////////////////////////
            div(id="_custom_area")
            {
                // script(src=""){$""}
                script(type="text/javascript")
                {$'
                    document.addEventListener("DOMContentLoaded", () => {
                        // Script injection
                        #<@@(@crud_context,"script")>
                    });
                '}
            }
        }
    }
    #!

    do @context.end()
}