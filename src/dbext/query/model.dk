#include "dkli.dkh"
#!
module "Galería de consultas:query"
{
    #include "dbr.security.dkl"

    @table_name = "dba_query"
    @keyfield = "id"

    @read_query = "
    SELECT
        sys_pk,
        sys_recver,
        cat,
        app,
        det,
        actid,
        id,
        title,
        IFNULL(qry,'') qry,
        IFNULL(properties,'') props,
        IFNULL(parameters,'') ctrls,
        IFNULL(design,'') design
    FROM #<@table_name>
    WHERE #<@keyfield> = @_entity_id
    "

    prepareDefaultReportData::&db,&data
    {
        using data
        {
            member @"titles"
            {
                @"title": dbr.vars.getd(db,"FXCA108","")
                @"subtitle": dbr.vars.getd(db,"FXCA109","")
                @"subtitle_2": dbr.vars.getd(db,"FXCA110","")
                @"footer": dbr.vars.getd(db,"FXCA111","")
            }
        }
    }

    function list(&db,&params)
    {
        namespace "query"

        do dbr.apps.action.grant("XB140")

        sql = "SELECT sys_pk, CONCAT(id,' - ',title) AS descripcion FROM dba_query_cat WHERE NOT IFNULL(sys_deleted,0) ORDER BY id;"
        ref categories = dbr.list(db,sql,@null)
        
        if not(field.exist(params,"fil_cat")) { params<"fil_cat"> : -1 }
        // if not(field.exist(params,"fil_cat")) {
        //     ref first_cat = record.create()
        //     if list.count(categories) > 0 { ref first_cat:list.obj(categories,0) }
        //     params<"fil_cat"> : @@(first_cat,"#sys_pk")
        // }

        sql = "SELECT sys_pk, id, title FROM dba_query WHERE NOT IFNULL(sys_deleted,0)"
        if @@(params,"#fil_cat") > 0 { sql = sql + " AND cat = @fil_cat" }
        if trim(@@(params,"$fil_text")) != "" { sql = sql + " AND (id = @fil_text OR title LIKE CONCAT('%',@fil_text,'%'))" }
        sql = sql + " ORDER BY id;"
        ref queries = dbr.list(db,sql,params)

        new resp
        {
            @"categories*": categories
            @"queries*": queries
        }
        do prepareDefaultReportData(db,resp)
        return resp

        exception{ do catch(db,params,@null) }
    }

    function read(&db,&params)
    {
        namespace "query"

        ref entity = entity.read(db,params)
        do dbr.apps.action.grant(@@(entity,"$actid"))

        json_props = ifempty(@@(entity,"$props"),"{}")
        if tolower(json_props) == "null" { json_props = "{}" }
        ref properties = from.json(json_props)

        json_ctrls = ifempty(@@(entity,"$ctrls"),"{}")
        if tolower(json_ctrls) == "null" { json_ctrls = "{}" }
        ref controls = from.json(json_ctrls)

        json_design = ifempty(@@(entity,"$design"),"{}")
        if tolower(json_design) == "null" { json_design = "{}" }
        ref design = from.json(json_design)

        ref data = list.create()
        sql = trim(@@(entity,"$qry"))
        if sql != ""
        {
            go foreach.fobj(key:key, value:def) with(controls)
            {
                control = tolower(trim(@@(def,"$control")))
                control = ranydiffchars(control,"abcdefghijklmnopqrstuvwxyz","-")
                control = replace(control,"-","")

                name = ifempty(@@(def,"$name"), key)
                id = ifempty(@@(def,"$id"), key)
                
                if not(field.exist(params,name))
                {
                    // 1 - $ | 2 - # | 3 - * | 0 - not exist
                    switch field.typeof(def,"default")
                    {
                        case 1 { params<name> : @@(def,"$default") }
                        case 2 { params<name> : @@(def,"#default") }
                        case 3 { params<name+"*"> : @@(def,"&default") }
                    }
                }
                
                if control == "inputkey"
                {
                    if @@(def,"$source/source") == "" {
                        def<"source/source"> : "/!/dbext/query/"+@@(entity,"$id")+"/"+id+"/?search=@search"
                    }
                    
                    ref value = record.create()
                    query = @@(def,"$source/query")
                    if query != "" {
                        params<"key"> : @@(params,name)
                        ref value:dbr.rec(db,query,params)
                    }
                    def<"source/value*"> : value
                }
            }
            
            ref data:dbr.list(db,sql,params)
        }
        design<"datatable*"> : data

        new resp
        {
            @"title": @@(entity,"$title")
            @"properties*": properties
            @"controls*": controls
            @"design*": design
            // @"data*": data
        }
        do prepareDefaultReportData(db,resp)
        return resp

        exception{ do catch(db,params,@null) }
    }

    function inputkey(&db,&params)
    {
        namespace "query"

        ref entity = entity.read(db,params)

        json_ctrls = ifempty(@@(entity,"$ctrls"),"{}")
        ref controls = from.json(json_ctrls)

        ref list = list.create_from_fields(controls)
        input_key_id = @@(params,"$_view")
        query = ""
        for i = 0; i < list.count(list)
        {
            key = list.str(list,i)
            ref def = field.obj(controls,key)

            control = tolower(trim(@@(def,"$control")))
            control = ranydiffchars(control,"abcdefghijklmnopqrstuvwxyz","-")
            control = replace(control,"-","")

            id = ifempty(@@(def,"$id"), key)
            if control == "inputkey" && id == input_key_id {
                query = @@(def,"$source/query")
                break
            }
        }

        if query != "" { return dbr.list(db,query,params) }
        return list.create()

        exception{ do catch(db,params,@null) }
    }

    createSitem::&db,&ndata
    {
        ref lsitem=list.create()
        new sitem
        {
            @"itemid":@@(ndata,"$actid")
            @"description":@@(ndata,"$title")
            @"itemparent":"dbext.query"
        }
        do list.add(lsitem,sitem)
        do dbr.vars.ImportPrivs(db,lsitem)

        ref permissions= list.create()
        do list.add(permissions,@@(ndata,"$actid"))
        admins_groupid = dbr.security.admins(db)
        do dbr.security.assign(db,admins_groupid,permissions)

        new action
        {
            @"id":@@(ndata,"$actid")
            @"title":cut(@@(ndata,"$title"),255)
            @"shorttitle":cut(@@(ndata,"$title"),25)
            @"icon16x16":@@(ndata,"$icon")
            @"href":"/!/dbext/query/"+@@(ndata,"$id")+"/"
            @"_blank":0
            @"appid":@@(ndata,"$app")
            @"itemtype":@@(ndata,"$det")
            @"req_context_item_id":0
            @"act_type":"action"
            //XB21,Agregar tipo de autorización,Agregar,,/!/dbext/authtpy/_new/,0,dbext.authtpy,DET052,0,action
        }
        ref lactions=list.create()
        do list.add(lactions,action)
        do dbr.apps.itemaction.import(db,lactions)
    }
    Getdata::&db,&data
    {
        ref ndata=record.copy(data,"actid,id,title,qry,app,det")

        do createSitem(db,data)

        if @@(data,"#category") > 0
        {
            ndata<"cat">:@@(data,"#category")
        }
        if not(isnull(@@(data,"&properties"))) {
            ndata<"properties">:to.json(@@(data,"&properties"))
        }
        if not(isnull(@@(data,"&parameters"))) {
            ndata<"parameters">:to.json(@@(data,"&parameters"))
        }
        if not(isnull(@@(data,"&design"))) {
            ndata<"design">:to.json(@@(data,"&design"))
        }
        return ndata
    }
    GetDataQuery::&db,&params
    {
        return dbr.rec(db,"select sys_pk,actid,title from dba_query where id=@_entity_id",params)
    }
    create::&db,&params,&data
    {
        @keyfield="id"
        ref ndata=query.Getdata(db,data)
        ref query=query.GetDataQuery(db,params)
        
        if isnull(query){ref entity= entity.create(db,params,ndata)}
        else{ref entity=query.update(db,params,data)}

        return entity

        exception{ do catch(db,params,data) }
    }
    update::&db,&params,&data
    {
        @keyfield="id"
        ref ndata=query.Getdata(db,data)

        ref query=query.GetDataQuery(db,params)
        
        if isnull(query){ref entity= entity.create(db,params,ndata)}
        else{do dbr.update(db,@table_name,ndata,"id=@_entity_id",params)}

        return ndata

        exception{ do catch(db,params,data) }
    }

    catch::&db,&params,&data
    {
        do errordet(@false)
        code = last_error_code()
        error = last_error()

        if contains_all_words(error,"Save Error,Duplicate entry") {
            error = "Entrada duplicada, ya existe un registro con los mismos valores."
        }
        if contains_all_words(error,"DELETE Error,CONSTRAINT,FOREIGN KEY,REFERENCES") {
            error = "No es posible eliminar el registro, otros registros son dependientes del elemento seleccionado."
        }

        if isset("@@_action_context") { do dbr.apps.action.log() }
        do clear_exceptions()
        do rise_error(code,error)
    }
}