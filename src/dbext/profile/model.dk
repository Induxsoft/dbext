#include "dkli.dkh"
#!
module "model"
{
    @table_name = "profile"

    function profile_read(&db, &params)
    {
        // if not(dbr.security.isauth(db,@AUT_READ_PERFIL)) { do rise_error(500,"No autorizado") }
        do dbr.apps.action.grant("XB50")

        ref group = dbr.rec(db, "SELECT sys_pk, groupid, description, IFNULL(notes,'') notes FROM usergroup WHERE sys_pk=@_entity_id LIMIT 1;", params)
        if not(isnull(group)) { group<"sitem_profile*">: get_group_sitem_profile(db, group) }
        return group

        exception
        {
            do errordet(@false)
            do dbr.apps.action.log()
            do rise_error(last_error_code(),last_error())
        }
    }
    function profile_list(&db, &params)
    {
        // if not(dbr.security.isauth(db,@AUT_ACCESS_PERFILES)) { do rise_error(500,"No autorizado") }
        do dbr.apps.action.grant("XB50")

        ref groups = dbr.list(db, "SELECT sys_pk, groupid, description, notes FROM usergroup;", @null)
        return groups

        exception
        {
            do errordet(@false)
            do dbr.apps.action.log()
            do rise_error(last_error_code(),last_error())
        }
    }
    function get_group_sitem_profile(&db, &group)
    {
        sql = "
        SELECT
            s.sys_pk,
            IFNULL(p.sys_guid,'') sys_guid,
            s.itemid,
            s.description,
            s.itemparent,
            IF(IFNULL(p.item,0)=0,'No','Sí') active
        FROM sitem s
	        LEFT JOIN (SELECT item, sys_guid FROM profile WHERE usergroup=@sys_pk) p ON s.sys_pk = p.item
        ORDER BY
            s.itemparent,
            s.sys_pk
        "

        return dbr.list(db, sql, group)
    }

    function profile_create(&db, &params, &data)
    {
        // if @@(params,"$_entity_id") == "_new" && not(dbr.security.isauth(db,@AUT_CREATE_PERFIL)) { do rise_error(500,"No autorizado") }
        // if @@(params,"$_entity_id") != "_new" && not(dbr.security.isauth(db,@AUT_UPDATE_PERFIL)) { do rise_error(500,"No autorizado") }

        ref profiles = @@(data, "&profile")
        sql_p = ""
        sql_delete=""
        rows=0
        if not(isnull(profiles)) && list.count(profiles) > 0
        {
            sql_p = "INSERT INTO profile (sys_timestamp, sys_guid, sys_dtcreated, item, usergroup) VALUES "
            
            for i = 0; i < list.count(profiles)
            {
                ref profile =record.caseinsensitive(list.obj(profiles, i))
                
                new _params
                {   
                    @"group":@@(params, "#_entity_id")
                    @"item":@@(profile, "$itemid")
                }

                _params<"sys_pk">:dbr.num(db,"select sys_pk from sitem where itemid=@item",_params)
                //verificar si el privilegio ya esta agrgado el profile
                exist_profile=dbr.num(db,"SELECT COUNT(*) FROM profile p INNER JOIN usergroup u ON p.usergroup=u.sys_pk WHERE p.usergroup=@group AND p.item=@sys_pk",_params) > 0
                
                ref sitem_sec=dbr.rec(db,"SELECT COUNT(*)_rows,IFNULL(s.itemid,'')itemid FROM sitem_sec ss 
                                    INNER JOIN sitem s ON ss.item_id=s.itemid
                                    WHERE s.sys_pk=@sys_pk;",_params)

                if exist_profile 
                {
                    if @@(sitem_sec,"#_rows") > 0 && not(parse.bool(@@(profile,"$active")))
                    {
                        do rise_error(500,"No es posible conceder o retirar el privilegio: "+@@(sitem_sec,"$itemid")+" privilegio con mayor seguridad.")
                    }

                    if not(parse.bool(@@(profile,"$active")))
                    {
                        sql_delete=sql_delete + ftext("DELETE FROM profile where item=#<@@(_params,'$sys_pk')> and usergroup=#<@@(params,'$_entity_id')>;")
                    }
                }
                else 
                {
                    if @@(sitem_sec,"#_rows") > 0
                    {
                        do rise_error(500,"No es posible conceder o retirar el privilegio: "+@@(sitem_sec,"$itemid")+" privilegio con mayor seguridad.")
                    }

                    guid = ifstr(trim(@@(profile,"$guid")) == "", toupper(uuid()), @@(profile,"$guid"))
                    item = @@(_params, "#sys_pk")
                    usergroup = @@(params, "#_entity_id")
                    
                    sql_p = sql_p + ftext("(NOW(), '#<guid>', NOW(), #<item>, #<usergroup>),")
                    rows=rows + 1
                    // sql_delete=sql_delete + ftext("DELETE FROM profile where item=#<@@(_params,'$sys_pk')> and usergroup=#<@@(params,'$_entity_id')>;")
                }
            }

            sql_p = rremove(sql_p,1) + ";"
        }

        // @use_transaction = @false

        // do dbr.begin(db)
        // eliminamos los registros de la configuración actual
        
        if trim(sql_delete)!=""{do dbr.execute(db,sql_delete,params)}
        // do dbr.execute(db, "DELETE FROM profile WHERE usergroup=@_entity_id", params)
        // Insertamos la nueva configuración si se recibió
        
        if rows > 0 { do dbr.execute(db, sql_p, @null) }
        // do dbr.commit(db)

        /* exception
        {
            if dbr.in_transaction(db) { do dbr.rollback(db) }
            do errordet(@false)
			do rise_error(last_error_code(),last_error())
        } */
    }

    function create(&db,&params,&data)
    {
        @use_transaction = @false

        do dbr.apps.action.pre("XB51")
        do dbr.begin(db)

        do profile_create(db,params,data)

        do dbr.apps.action.pos(@null)
        do dbr.commit(db)
        do dbr.apps.action.ext(@null)

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db){ do dbr.rollback(db) }
            do dbr.apps.action.log()
            do rise_error(last_error_code(),last_error())
        }
    }

    function update(&db,&params,&data)
    {
        @use_transaction = @false

        do dbr.apps.action.pre("XB52")
        do dbr.begin(db)

        do profile_create(db,params,data)

        do dbr.apps.action.pos(@null)
        do dbr.commit(db)
        do dbr.apps.action.ext(@null)

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db){ do dbr.rollback(db) }
            do dbr.apps.action.log()
            do rise_error(last_error_code(),last_error())
        }
    }

    function profile_delete(&db,&params)
    {
        // if not(dbr.security.isauth(db,@AUT_DELETE_PERFIL)) { do rise_error(500,"No autorizado") }
        @use_transaction = @false

        do dbr.apps.action.pre("XB53")
        do dbr.begin(db)

        ref result = entity.delete(db,params)

        do dbr.apps.action.pos(result)
        do dbr.commit(db)
        do dbr.apps.action.ext(result)

        return result

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db){ do dbr.rollback(db) }
            do dbr.apps.action.log()
            do rise_error(last_error_code(),last_error())
        }
    }

    point @read to profile_read
    point @list to profile_list
    point @create to create //profile_create
    point @update to update //profile_create
    point @delete to profile_delete
}