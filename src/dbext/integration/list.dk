#include "dkli.dkh"
#!
module "list"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "uielements.v12.dkl"
    #include "../config.dk"
    #include "../_lib/scape_special_charactes2.dk"
    #include "batch.v12.dkl"

    do @context.begin(@crud_context)
    ref integrations=ifnull(@("&."),list.create())
    ref db=@("&database")

    tbtn_style = "cursor:pointer; text-decoration:none; border:1px solid gray; outline:none; padding: 0px 8px; background-color:#F5F5F5; color:#000000;"
    new table_definition
    {
        @"datatable*": integrations
        @"tableheight": "96%"
        @"table_footer": "Mostrando los primeros # filas"
        member @"columns"
        {
            member @"id" { @"caption": "ID" }
            member @"description"{@"caption": "Descripción"}
            member @"token" { @"caption": "Token" }
            member @"source"{@"caption": "Source"}
            member @"deshabilitado"{@"caption":"Deshabilitado"}

            member @"_action"
            {
                @"caption":""
                @"align":"center"
                @"template":ftext('
                    <div style="display:flex;gap:8px;justify-content:center;width:100%;" class="no-print">
                        <a href="./${DataRow.sys_pk}/" style="#<tbtn_style>">Editar</a>
                        <button onclick="InduxsoftCrudlModel.Delete(${DataRow.sys_pk})" style="#<tbtn_style>">Eliminar</button>
                    </div>
                ')
            }
        }
        @"control_styles":'
            tbody tr:hover { background-color: #F5F5F5 !important; }
            .EdiTable-Row-Selected { background-color:unset !important; color:unset !important; } 
        '
    }
    #$
    div(class="container p-0")
    {
        div(id="main_bar" class="row container-section my-2 px-0 py-2 border-bottom")
        {
            div(class="col-4 d-flex align-items-center p-0")
            {
                h5(class="tex-no-break m-0"){$"Puntos finales"}
            }
            div(class="col-8 d-flex align-items-center justify-content-end p-0 gap-2")
            {
                a(href="./_new/" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print"){$"Agregar"}
                a(href="./" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" title="Refrescar"){$"#<@@(@icons,'ARROW_CLOCKWISE')>"}
                a(href="/" target="_top" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" title="Salir"){$"#<@@(@icons,'X')>"}
            }
        }
        div(id="work_area" class="container-section pt-2")
        {
            #!
            do uie.dbeditable(table_definition,"table_agent")
            #$
        }
    }
}