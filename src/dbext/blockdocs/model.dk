#include "dkli.dkh"
#!
module ""
{
    @table_name="blockdocumentos"
    like=" having if(ifnull(@s,'')='',true, concat_ws('',tipo,serie,finicial,fultimo,factivo,ffiscal) like concat('%',@s,'%') )"
    @list_query="SELECT bd.sys_pk,cd.const tipo,bd.serie,bd.finicial,bd.fultimo,if(IFNULL(bd.activo,0),'Activo','Inactivo')factivo,if(IFNULL(bd.fiscal,0),'Sí','No')ffiscal
    FROM blockdocumentos bd
    INNER JOIN cdocumentos cd ON bd.documento=cd.id 
    and if(ifnull(@tipo,0)=0,true,cd.id=@tipo)
    and if(ifnull(@activo,0)=0,true,bd.activo=@activo)
    and if(ifnull(@fiscal,0)=0,true,bd.fiscal=@fiscal)
    "+like+"
    order by cd.id,bd.sys_pk desc "

    Prepare.View::&db,&params,&data
    {
        if isnull(data){return}
        data<"docs*">:dbr.list(db,"select id,const descripcion from cdocumentos;",@null)        
    }
    blank::&db,&params
    {
        do dbr.apps.action.grant("XB30")

        new entity{}
        do Prepare.View(db,params,entity)
        return entity

        exception
        {
            do errordet(@false)
            do dbr.apps.action.log()
            do rise_error(last_error_code(),last_error())
        }
    }

    save::&db,&params,&data
    {
        // if @@(params,"$_entity_id") == "_new" && not(dbr.security.isauth(db,@AUT_CREATE_FOLIO)) { do rise_error(500,"No autorizado") }
        // if @@(params,"$_entity_id") != "_new" && not(dbr.security.isauth(db,@AUT_UPDATE_FOLIO)) { do rise_error(500,"No autorizado") }

        if @@(data,"$finicial")=="" || @@(data,"#finicial")<1{data<"finicial">:1}
        if @@(data,"$fultimo")==""{data<"fultimo">:0}
        if @@(data,"$numcontrol")==""{data<"numcontrol">:0}

        if parse.bool(@@(data,"activo")){data<"activo">:1}
        else{data<"activo">:0}

        if parse.bool(@@(data,"fiscal")){data<"fiscal">:1}
        else{data<"fiscal">:0}

        ref entity=@null
    
        if @@(params,"$_entity_id")!="_new"{ref entity= entity.update(db,params,data)} 
        else{ref entity=entity.create(db,params,data)}

        exception
        {
            do Prepare.View(db,params,data)
            do rise_error(500,last_error())
        }
        return entity
    }

    create::&db,&params,&data
    {
        @use_transaction = @false

        do dbr.apps.action.pre("XB31")
        do dbr.begin(db)

        ref result = save(db,params,data)

        do dbr.apps.action.pos(result)
        do dbr.commit(db)
        do dbr.apps.action.ext(result)

        return result

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db){ do dbr.rollback(db) }
            code = last_error_code()
            error = last_error()
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
    }

    update::&db,&params,&data
    {
        @use_transaction = @false

        do dbr.apps.action.pre("XB32")
        do dbr.begin(db)

        ref result = save(db,params,data)

        do dbr.apps.action.pos(result)
        do dbr.commit(db)
        do dbr.apps.action.ext(result)

        return result

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db){ do dbr.rollback(db) }
            do dbr.apps.action.log()
            do rise_error(last_error_code(),last_error())
        }
    }

    delete::&db,&params
    {
        // if not(dbr.security.isauth(db,@AUT_DELETE_FOLIO)) { do rise_error(500,"No autorizado") }

        @use_transaction = @false

        do dbr.apps.action.pre("XB33")
        do dbr.begin(db)

        ref result = entity.delete(db,params)

        do dbr.apps.action.pos(result)
        do dbr.commit(db)
        do dbr.apps.action.ext(result)

        return result

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db){ do dbr.rollback(db) }
            do dbr.apps.action.log()
            do rise_error(last_error_code(),last_error())
        }
    }

    read::&db,&params
    {
        // if not(dbr.security.isauth(db,@AUT_READ_FOLIO)) { do rise_error(500,"No autorizado") }
        do dbr.apps.action.grant("XB30")

        ref entity=entity.read(db,params)
        do Prepare.View(db,params,entity)
        return entity

        exception
        {
            do errordet(@false)
            do dbr.apps.action.log()
            do rise_error(last_error_code(),last_error())
        }
    }

    list::&db,&params
    {
        // if not(dbr.security.isauth(db,@AUT_ACCESS_FOLIOS)) { do rise_error(500,"No autorizado") }
        do dbr.apps.action.grant("XB30")

        return entity.list(db,params)

        exception
        {
            do errordet(@false)
            do dbr.apps.action.log()
            do rise_error(last_error_code(),last_error())
        }
    }
    
    point @list to list
    point @read to read
    point @create to create
    point @update to update
    point @delete to delete
    point @blank to blank
}