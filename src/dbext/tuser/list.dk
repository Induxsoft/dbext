#include "dkli.dkh"
#!
module "list"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "uielements.v12.dkl"
    #include "../config.dk"
    #include "../_lib/scape_special_charactes2.dk"
    #include "batch.v12.dkl"

    do @context.begin(@crud_context)

    ref grupos = ifnull(@("&./grupos"),list.create())
    ref usuarios = ifnull(@("&./usuarios"),list.create())

    do scape_special_charactes(usuarios,"userid,username")

    new fil_gpo_usuarios
    {
        @"id": "fil_gpo"
        @"datatable*": grupos
        member "attributes"
        {
            @"class": "form-select rounded-0"
            @"name": "fil_gpo"
            @"title": "Filtrar por grupo"
            @"onchange": "document.querySelector('#form_search').submit();"
        }
        @"value_field": "sys_pk"
        @"text_field": "description"
        @"first_value": "-1"
        @"first_text": "Todos los grupos"
        @"selected": @("#parameters/fil_gpo")
    }
    
    ref db=@("&database")
    new p
    {
        @"jobgroup": @jobgroup
        @"program": @program_importar_users
    }

    ref dtProgram = batch.return_job(db,p)
    reset=@false
    if isnull(dtProgram)
    {
        reset=@true
        ref dtProgram=dbr.rec(db,"SELECT sys_pk,jg.sys_pk jp_ref FROM jobsgroup jg WHERE jg.sys_guid=@jobgroup OR jg.name=@jobgroup ",p)
    }
       
    do batch.getConfig(db)

    interval_time = @batch_interval_time
    progress_type = @batch_progress_type
    steps = @batch_steps

    program_token = @@(dtProgram,"$sys_guid")
    program_status = @@(dtProgram,"#status")
    program_st_text = @@(dtProgram,"$status_text")

    show_spinner = (program_status < 3)
    show_st_text = (program_status < 3)

    if reset
    {
        show_spinner=@false
        show_st_text=@false
    }
    #$
    div(class="container p-0")
    {
        script(src="#<@JS_TUSER>"){$""}
        link(href="#<@CSS_MAIN>" rel="stylesheet" type="text/css"){""}
        div(id="main_bar" class="row container-section my-2 px-0 py-2 border-bottom")
        {
            div(class="col-4 d-flex align-items-center p-0")
            {
                h5(class="tex-no-break m-0"){$"Usuarios"}
            }
            div(class="col-8 d-flex align-items-center justify-content-end p-0 gap-2")
            {
                div(class="spinner-border text-secondary #<ifstr(show_spinner,'','d-none')>" role="status" id="spinner"){span(class="visually-hidden"){$"En ejecucion..."}}
                input(type="file" id="file" name="file" class="d-none" accept=".csv")
                label("for"="file" id="btn_run_program" class="btn border-secondary btn-sm induxsoft-corners btn-main-action" ){"Importar"}

                a(href="#<replace(@DBEXT_ADD_EDIT_TUSER, '@id', '_new')>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print"){$"Agregar"}
                button(class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" title="Imprimir" onclick="window.print()"){$"#<@@(@icons,'PRINTER')>"}
                a(href="./" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" title="Refrescar"){$"#<@@(@icons,'ARROW_CLOCKWISE')>"}
                a(href="/" target="_top" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" title="Salir"){$"#<@@(@icons,'X')>"}
            }
        }
        div(id="work_area" class="container-section pt-2")
        {
            form(action="./" method="GET" id="form_search" class="no-print my-1 d-flex py-1")
            {
                div(class="d-flex align-items-center gap-2 flex-wrap w-100 py-1")
                {
                    div(class="d-flex gap-2")
                    {
                        div{ #! do uie.dbSelect(fil_gpo_usuarios) } #$
                    }
                    div(class="flex-grow-1")
                    {
                        "filter-text"(
                            "id"="ft_search"
                            "text-field"="s"
                            "placeholder"="Buscar"
                            "form"="#form_search"
                            "value"="#<@@(@@(@crud_context,'&http/request/get'),'$s')>"
                            "auto-submit"="true"
                            "class"="w-100"
                        ){$""}
                    }
                }
            }
            div
            {
                #! lenght = list.count(usuarios)
                if lenght <= 0
                {
                    message = ""
                    if @@(@crud_context,"$parameters/s") == "" { message = "Sin registros." }
                    else  { message = "Sin resultados." }

                    #$ div(class="text-center")
                    {
                        h6(style="background-color: #F5F5F5; padding: 10rem 0;"){"#<message>"}
                    }
                }
                #! else 
                {
                    #$ div(style="overflow-y:auto;max-height: 75vh;" class="mb-2" id="list_table_container")
                    {
                        table(class="table")
                        {
                            thead
                            {
                                tr
                                {
                                    th(class="h6"){$"User ID"}
                                    th(class="h6"){$"Nombre"}
                                    th(class="h6 text-center no-print"){$"Acciones"}
                                }
                            }
                            tbody
                            {
                                $""
                                #! for i = 0; i < list.count(usuarios)
                                {
                                    ref usuario = list.obj(usuarios, i)

                                    #$ tr
                                    {
                                        td{$"#<@@(usuario,'$userid')>"}
                                        td{$"#<@@(usuario,'$username')>"}
                                        td(class="no-print")
                                        {
                                            div(class="d-flex gap-2 justify-content-center")
                                            {
                                                a(href="#<replace(@DBEXT_ADD_EDIT_TUSER, '@id', @@(usuario,'sys_pk'))>" class="btn btn-sm btn-light"){$"Editar"}
                                                button(class="btn btn-sm btn-light" onclick="InduxsoftCrudlModel.Delete(#<@@(usuario,'sys_pk')>)"){$"Eliminar"}
                                            }
                                        }
                                    }
                                } 
                            }
                        }
                    }
                    #! a1 = ftext("Mostrando los primeros #<lenght> Usuarios ordenados por ID.")
                    #$ small(class="text-secondary"){$"#<a1>"}
                }
            }
        }
        div(id="status_bar" class="container-section")
        {
            $""
        }
        #$
        script
        {
            $'
            batch.url_taskman="#<replace(@BATCH_DETAIL_PROG_TASKMAN,"{taskname}",@@(p,"$program"))>";
            batch.id_jog=#<@@(dtProgram,"#jp_ref")>;
            batch.program_token = "#<program_token>";
            batch.program_status = #<program_status>;
            batch.interval_time = #<interval_time>;
            batch.progress_type = #<progress_type>;
            batch.steps = #<steps>;
            batch.job = "#<@@(dtProgram,"sys_guid")>";
            batch.iniciar_job=false;
            batch.show_spinner=#<show_spinner>;
            '
        }
    }
}