#include "dkli.dkh"
#!
module "model"
{
    #include "../config.dk"
    #include "../_lib/lib.dk"

    @table_name = "tuser"

    // @read_query = ""
    // @list_query = "SELECT * FROM tuser;"

    function tuser_create(&db,&params,&data)
    {
        ref groups = @null

        if field.exist(data,"groups")
        {
            ref groups = from.json(@@(data,"$groups"))
            do field.remove(data, "groups")
        }
        if field.exist(data,"pwd")
        {
            data<"pwd">:toupper(md5e(@@(data,"pwd"), "Unicode"))
            data<"pwdmd5">:toupper(md5(@@(data,"pwd")))
        }

        do dbr.execute(db,"update tuser set sys_recver = ifnull(sys_recver,0), sys_lock = null where sys_pk=@sys_pk",data)
        data<"locked"> : parse.bool(@@(data,"$locked"))

        ref res = record.caseinsensitive(entity.create(db,params,data))

        if not(isnull(groups)){do tuser_add_to_groups(db, groups, @@(res,"#sys_pk"))}

        return res

        exception
        {
            do cu_error("usuario")
            do rise_error(500, last_error())
        }
    }

    function create(&db,&params,&data)
    {
        @use_transaction = @false

        do dbr.apps.action.pre("XB61")
        do dbr.begin(db)

        ref result = tuser_create(db,params,data)

        do dbr.apps.action.pos(result)
        do dbr.commit(db)
        do dbr.apps.action.ext(result)

        return result

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db){ do dbr.rollback(db) }
            data<"groups*">: get_user_groups(db, @@(data, "#sys_pk"))
            do dbr.apps.action.log()
            do rise_error(last_error_code(),last_error())
        }
    }

    function update(&db,&params,&data)
    {
        @use_transaction = @false

        do dbr.apps.action.pre("XB62")
        do dbr.begin(db)

        ref result = tuser_create(db,params,data)

        do dbr.apps.action.pos(result)
        do dbr.commit(db)
        do dbr.apps.action.ext(result)

        return result

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db){ do dbr.rollback(db) }
            data<"groups*">: get_user_groups(db, @@(data, "#sys_pk"))
            do dbr.apps.action.log()
            do rise_error(last_error_code(),last_error())
        }
    }
    ColumnExist::&db,table,column
    {
        ref columns=dbr.rec(db,"SHOW COLUMNS FROM "+table+" LIKE '"+column+"';",@null)

        return not(isnull(columns))
    }
    function tuser_add_to_groups(&db, &groups, user_pk)
    {
        new prm { @"user": user_pk }
        //validar mayor seguridad del grupo de usuario
        //esto se valida antes de eliminar todos los grupos del usuario
        
        for i = 0; i < list.count(groups)
        {
            new ugroup 
            {
                @"groups": list.num(groups, i)
                @"users": @@(prm, "#user")
            }
            
            //verificar si el usuario aun no esta en el grupo
            if dbr.num(db,"select count(*) from user_usergroup_ where `groups`=@groups and users=@users",ugroup) < 1
            {
                //validar si el grupo tiene mayor seguridad
                ref usergroup_sec=dbr.rec(db,"SELECT COUNT(*) _rows,IFNULL(us.group_id,'')group_id,IFNULL(ug.groupid,'')groupid 
                FROM usergroup_sec us 
                INNER JOIN usergroup ug ON us.group_id=ug.groupid 
                WHERE ug.sys_pk=@groups",ugroup)

                if @@(usergroup_sec,"#_rows") > 0
                {
                    do rise_error(500,"No es posible agregar o quitar usuarios al grupo: "+@@(usergroup_sec,"$groupid")+" grupo con mayor seguridad.")
                }
            }
        }
        
        // Eliminamos todos los registros del usuario indicado
        do dbr.execute(db, "DELETE FROM user_usergroup_ WHERE users=@user", prm)
        // Verificamos si la tabla requiere un sys_guid (tablas creadas con dba)
        require_sys_guid =ColumnExist(db,"user_usergroup_","sys_guid")
        // Agregamos todos los grupos al usuario indicado
        for i = 0; i < list.count(groups)
        {
            new ugroup 
            {
                // @"sys_timestamp*": dbr.sql("NOW()")
                @"groups": list.num(groups, i)
                @"users": @@(prm, "#user")
            }
            if require_sys_guid 
            { 
                ugroup<"sys_guid">: toupper(uuid()) 
                do dbr.execute(db,"insert into user_usergroup_(sys_timestamp,sys_guid,`groups`,users) values(now(),@sys_guid,@groups,@users)",ugroup)
            }
            else 
            {
                do dbr.execute(db,"insert into user_usergroup_(sys_timestamp,`groups`,users) values(now(),@groups,@users)",ugroup)
            }
            // do dbr.insert(db, "user_usergroup_", ugroup)
        }
    }

    function tuser_read(&db, &params)
    {
        // if not(dbr.security.isauth(db,@AUT_READ_USUARIO)) { do rise_error(500,"No autorizado") }
        do dbr.apps.action.grant("XB60")

        ref res = entity.read(db, params)
        if not(isnull(res)) 
        {
            ref res = record.caseinsensitive(res)
            res<"groups*">: get_user_groups(db, @@(res, "#sys_pk"))
        }
        return res

        exception
        {
            do errordet(@false)
            do dbr.apps.action.log()
            do rise_error(last_error_code(),last_error())
        }
    }

    function tuser_blank(&db, &params)
    {
        do dbr.apps.action.grant("XB60")

        new res {}
        res<"groups*">: get_user_groups(db, @@(res, "#sys_pk"))
        return res

        exception
        {
            do errordet(@false)
            do dbr.apps.action.log()
            do rise_error(last_error_code(),last_error())
        }
    }

    function get_user_groups(&db, user_pk)
    {
        new prm { @"user": user_pk }
        ref groups=dbr.list(db,"SELECT sys_pk grupo_pk, groupid, description groupdescription FROM usergroup;",@null)
        ref uugs=dbr.list(db,"SELECT `groups` FROM user_usergroup_ WHERE users=@user",prm)

        for i=0;i<list.count(groups) 
        {
            ref group=list.obj(groups,i)
            added=@false

            for j=0;j<list.count(uugs) 
            {
                ref uug=list.obj(uugs,j)
                if @@(group,"#grupo_pk")==@@(uug,"#groups"){added=@true}
            }
            group<"added">: added
        }
        
        return groups
    }

    function tuser_delete(&db, &params)
    {
        @use_transaction = @false

        do dbr.apps.action.pre("XB63")
        do dbr.begin(db)

        ref entity = @null
        deleted = @false

        codeblock "Intentar eliminacón física"
        {
            do dbr.execute(db, "DELETE FROM user_usergroup_ WHERE users=@_entity_id;", params)
            do dbr.execute(db, "DELETE FROM uservar WHERE fuser=@_entity_id;", params)
            do entity.delete(db,params)

            deleted = @true
            exception{ do pop_exception() }
        }
        if not(deleted)
        {
            params<"lastuser"> : @@(@http_context,"$session/user/uid")
            sql = "
            UPDATE tuser SET
                sys_timestamp = now(),
                sys_lastuser = @lastuser,
                sys_deleted = 1,
                sys_info = userid,
                userid = CONCAT('~',sys_pk)
            WHERE sys_pk = @_entity_id
            "
            do dbr.execute(db,sql,params)
            
            ref entity:entity.read(db,params)
        }
        
        do dbr.apps.action.pos(entity)
        do dbr.commit(db)
        do dbr.apps.action.ext(entity)

        return @true
        
        excepcion
        {
            do errordet(@false)
            if dbr.in_transaction(db) { do dbr.rollback(db) }
            do dbr.apps.action.log()
            do rise_error(500, last_error())
        }
    }

    function list(&db, &params)
    {
        do dbr.apps.action.grant("XB60")

        sql = "
        SELECT
            u.sys_pk,
            u.userid,
            u.username,
            GROUP_CONCAT(DISTINCT g.groupid SEPARATOR ';') _grupos,
            GROUP_CONCAT(DISTINCT g.description SEPARATOR '; ') grupos
        FROM tuser u
            LEFT JOIN user_usergroup_ ug ON ug.users = u.sys_pk
            LEFT JOIN usergroup g ON ug.groups=g.sys_pk
        WHERE NOT IFNULL(u.sys_deleted,0)
            AND NOT IFNULL(u.external,0)
            AND IF(IFNULL(@fil_gpo,'-1')='-1', TRUE, ug.groups = @fil_gpo)
            AND IF(IFNULL(@s,'')='', TRUE, (u.userid = @s OR u.username LIKE CONCAT('%',@s,'%')))
        GROUP BY u.userid
        ORDER BY u.username ASC
        LIMIT #<@default_max_rows>;
        "

        new data
        {
            @"usuarios*": dbr.list(db,ftext(sql),params)
            @"grupos*": dbr.list(db,"SELECT sys_pk, groupid, description FROM usergroup WHERE NOT IFNULL(sys_deleted,0) ORDER BY description ASC;",@null)
        }
        return data

        exception
        {
            do errordet(@false)
            do dbr.apps.action.log()
            do rise_error(last_error_code(),last_error())
        }
    }

    function cu_error(table)
    {
        new fields
        {
            @"userid": "El nombre de inicio de sesión"
        }
        do valide_duplicate(fields, table, last_error(), last_error_code())
    }

    point @create to create 
    point @update to update 
    point @read to tuser_read
    point @list to list
    point @blank to tuser_blank
    point @delete to tuser_delete
}