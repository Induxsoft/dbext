#include "dkli.dkh"
#!
module "Controller configs"
{
	#include "functions.dkh"
	#include "serialize.dkh"
	#include "dbr.dkh"
	#include "dbr.apps.dkl"
	#include "dbr.events.dkl"
	#include "dbr.security.dkl"
	#include "dbr.vars.dkl"
	#include "crudl/crudl.dk"
	#include "./config.dk"
	#include "_lib/lib.dk"

	ref @web_utility=_import_library("System.Web.HttpUtility.dll")
    do _map_function(@web_utility, "System.Web.HttpUtility", "UrlDecode", "urldecode","System.String","$")

	@base_path="dbext"
	@path_root="" // Establezca una ruta de ser necesario

	if @@(@http_context,"$session/user/ids") == "" {
		if file.exists("webshell/lost.dk") { include "webshell/lost.dk" }
		else { @http_context<"response/headers/location"> : "/" }
		return
	}

	//No modifique a menos que sepa lo que está haciendo
	do crudl.routes.pattern("/_program/")
	do crudl.routes.entity("/user/","user")
	do crudl.routes.entity("/tuser/","tuser")
	do crudl.routes.entity("/usergroup/","usergroup")
	do crudl.routes.entity("/ugroups/","ugroups")
	do crudl.routes.entity("/profile/","profile")
	do crudl.routes.entity("/globalvar/","globalvar")
	do crudl.routes.entity("/blockdocs/","blockdocs")
	do crudl.routes.entity("/authbox/","authbox")
	do crudl.routes.entity("/authtpy/","authtpy")
	do crudl.routes.entity("/comm/","comm")
	do crudl.routes.entity("/smtp/","smtp")
	do crudl.routes.entity("/detusr/","detusr")
	do crudl.routes.entity("/divisa/","divisa")
	do crudl.routes.entity("/pais/","pais")
	do crudl.routes.entity("/edoprov/","edoprov")
	do crudl.routes.entity("/ciudad/","ciudad")
	do crudl.routes.entity("/sitem/","sitem")
	do crudl.routes.entity("/packs/","packs")
	do crudl.routes.entity("/apps/","apps")
	do crudl.routes.entity("/det/","det")
	do crudl.routes.entity("/run/","run")
	do crudl.routes.entity("/query/","query")
	do crudl.routes.entity("/recbin/","recbin")
	do crudl.routes.entity("/cat_query/","cat_query")

	@dbmvc_path="crudl/"
	
	@auto_crud=@true

	@db_engine="MY_SQL"	

	@list_view="list.dk"
	@form_view="form.dk"
	@error_view="error.dk"

	@entity_id_blank="_new"

	@dkl_view_ext=".dk"
	@websencia_ext=".jsnwm"

    @crudl.user="admin"
    @crudl.pwd=""

    @path_template_protected=@path_root+"/_protected/default.htt"

    @crudl.enable_idreplacement=@true

    @ws=@@(@http_context,"request/get/ws")

    @crudl.qname=""

	@crudl.access_privilege='
	{
		"access":[{"workspace":"'+@ws+'"}]
	}'

	#include "crudl/controller.dkl"
}