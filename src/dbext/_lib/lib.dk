#include "dkli.dkh"
#!
module
{
    #include "functions.dkh"

    function valide_duplicate(&fields, table, error, code)
    {
        if contains(tolower(error),"duplicate entry")
        {
            go foreach.fstr(index:i, key:key, value:value) with(fields)
            {
                if contains(tolower(error),key)
                {
                    do errordet(@false)
                    do rise_error(code, value + " de "+ table +" ya existe, intente con un valor diferente.") 
                }
            }
        }
    }
    function get_url_exit(&params,url_def)
    {
        url = url_def
        if @@(params,"$exit_url") != "" 
        { 
            url = @@(params,"$url_exit") 
        }
        else if @@(params,"$exit_url_encode") != "" 
        { 
            url = url_dcode(@@(params,"$exit_url_encode")) 
            exception{}
        }
        return url
    }
    function current_url(&context,with_params)
    {
        meth = ifstr(parse.bool(@@(context,"request/headers/HTTPS")),"https","http")
        host = @@(context, "request/headers/HTTP_HOST")
        port = @@(context, "request/headers/SERVER_PORT")
        prms = ifstr(with_params,@@(context, "request/headers/REQUEST_URI"),"")

        return meth+"://"+host+":"+port+prms
    }
}