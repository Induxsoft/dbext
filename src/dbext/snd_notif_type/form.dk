#include "dkli.dkh"
#!
module "form.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "uielements.v12.dkl"
    #include "dbr.controls.dkl"

    do @context.begin(@crud_context)

    @_entities_type = @("$parameters/_entities_type")
    @_entity_id     = @("$parameters/_entity_id")
    @is_new         = (@_entity_id == "_new")
    @form_id        = @_entities_type
    url_exit        = ".."

    function printNavButtons()
    {
        cls = "btn btn-main-action btn-sm border-secondary induxsoft-corners no-shadow"
        #$
        button(class="#<cls>" type="submit" form="#<@form_id>" title="Guardar"){$"Guardar"}
        #!
    }
    point buttons to printNavButtons

    new nav_config
    {
        @"title":    ifstr(@is_new, "Crear", "Editar") + " tipo de notificación"
        @"urlexit":  url_exit
        @"buttons*": buttons

        member @"hidden"
        {
            @"send":  @true
            @"copy":  @true
            @"csv":   @true
            @"print": @true
        }
    }

    // Selector de canal. Al cambiar recarga la página para renderizar
    // los controles dinámicos del proveedor (manifest).
    new snd_channel
    {
        @"id":         "snd_channel"
        @"text_field": "name"
        @"value_field": "sys_pk"
        @"datatable*": ifnull(@("&./snd_channel"), list.create())
        @"selected":   @("./template")
        member "attributes"
        {
            @"class":    "form-select"
            @"name":     "template"
            @"required": ""
        }
        member "attr_options"
        {
            @"#<ifstr(@@(row,'$sys_pk')=='', 'disabled', '')>": ""
        }
    }

    // Controles dinámicos del proveedor y valores actuales de params.
    ref ch_params_def  = ifnull(@("&./template_controls"), record.create())
    ref @control_params = @("&./params")

    #$
    div(class="container-lg" id="view")
    {
        section(id="top_area")
        {
            #!
            do uie.printV12FormBar(nav_config)
            #$
        }

        section(id="work_area" style="overflow-y:auto; overflow-x:hidden;")
        {
            link(href="/$/dbext/css/main.css" rel="stylesheet")
            #!
            error = @("$error/message")
            if error != ""
            {
                #$
                div(class="alert alert-danger alert-dismissible fade show mb-2 pb-1" role="alert")
                {
                    div(class="w-100 overflow-auto pb-2"){$"#<error>"}
                    button(type="button" class="btn-close" "data-bs-dismiss"="alert" "aria-label"="Close"){""}
                }
                #!
            }
            #$

            form(class="px-1" action="./" method="POST" id="#<@form_id>")
            {
                input(type="hidden" name="sys_pk"     value="#<@('#./sys_pk')>")
                input(type="hidden" name="sys_recver" value="#<@('#./sys_recver')>")

                div(class="row gx-1 gx-sm-2 gx-md-3 gx-lg-4 mb-3")
                {
                    // Nombre
                    div(class="col-12 col-md-5")
                    {
                        label(class="form-label" "for"="name"){"Nombre"}
                        input(class="form-control" type="text" id="name" name="name" value="#<@('$./name')>" maxlength="100" required="")
                    }
                    // Canal — al cambiar dispara recarga para obtener controles dinámicos
                    div(class="col-12 col-md-4")
                    {
                        label(class="form-label" "for"="snd_channel"){"Canal"}
                        ##
                        do uie.dbSelect(snd_channel)
                        ##
                    }
                    // Activo
                    div(class="col-auto align-self-end pt-2")
                    {
                        #!
                        checked = ifstr(@("#./enabled") || @is_new, "checked", "")
                        #$
                        div(class="form-check mb-2")
                        {
                            input(class="form-check-input" type="checkbox" name="enabled" value="1" id="enabled" "#<checked>"="")
                            label(class="form-check-label" "for"="enabled"){"Activo"}
                        }
                    }
                    // Descripción
                    div(class="col-12 mt-1")
                    {
                        label(class="form-label" "for"="description"){"Descripción"}
                        input(class="form-control" type="text" id="description" name="description"
                              value="#<@('$./description')>" maxlength="255"
                              placeholder="Explica cuándo usar este tipo")
                    }
                }
            }

            // Controles dinámicos generados desde el manifest del proveedor.
            // Se serializan como JSON en payload.params al hacer submit.
            form(class="row px-1" id="form-params")
            {""
                #!
                do dbr.control.GenerateHtml(@("&database"), ch_params_def)
                #$
            }
        }

        section(id="bottom_area")
        {
            div(id="_custom_area")
            {
                script(src="/$/dbext/js/snd_notif_type.js"){""}
                script(type="text/javascript")
                {$'
                    document.addEventListener("DOMContentLoaded", () => {
                        snd_notif_type.form_id = "#<@form_id>";
                        snd_notif_type.urlexit = "#<url_exit>";
                        snd_notif_type.init();
                        #<@@(@crud_context, "$script")>
                    });
                '}
            }
        }
    }
    #!

    do @context.end()
}
