#include "dkli.dkh"
#!
module ":divisa"
{
	@list_query = "
	SELECT sys_pk, codigo, descripcion, tcambio, IFNULL(decimales,0) decimales
    FROM #<@table_name>
    WHERE NOT IFNULL(sys_deleted,0)
		AND IF(IFNULL(@s,'')='', true, (codigo = @s OR descripcion LIKE CONCAT('%',@s,'%')))
    ORDER BY codigo
    LIMIT #<@default_max_rows>;
	"
    @read_query = "SELECT sys_pk, sys_recver, codigo, descripcion, tcambio, IFNULL(decimales,0) decimales FROM #<@table_name> WHERE #<@keyfield> = @_entity_id LIMIT 1;"

    function check_autocode(&db,table,field,&data)
    {
        varvalue = dbr.vars.getd(db,"FXCA058","|0000")
        ref config = dbr.autocode.info(varvalue)
        new_code = dbr.autocode.new(db,table,field,config)

        data<"codigo">: new_code

        exception{ do pop_exception() }
    }

    function cu_error(table)
    {
        new fields
        {
            @"codigo": "El código"
            @"descripcion": "La descripción"
        }
        do valide_duplicate(fields, table, last_error(), last_error_code())
    }

    function list(&db,&params)
    {
		do dbr.apps.action.grant("XB100")
		return entity.list(db,params)

		exception
		{
			do errordet(@false)
			do dbr.apps.action.log()
			do rise_error(last_error_code(),last_error())
		}
    }

    function read(&db,&params)
    {
		do dbr.apps.action.grant("XB100")
        return entity.read(db,params)

		exception
		{
			do errordet(@false)
			do dbr.apps.action.log()
			do rise_error(last_error_code(),last_error())
		}
    }

    function blank(&db,&params)
    {
		do dbr.apps.action.grant("XB100")
        
        return entity.blank(db,params)

		exception
		{
			do errordet(@false)
			do dbr.apps.action.log()
			do rise_error(last_error_code(),last_error())
		}
    }
    
    function create(&db,&params,data)
    {
		@use_transaction = @false

		do dbr.apps.action.pre("XB101")
		do dbr.begin(db)
		
        if @@(data,"tcambio")=="" { do field.remove(data,"tcambio") }

        if @@(data,"codigo")=="" { do check_autocode(db,"divisa","codigo",data) }
        ref res = entity.create(db,params,data)
				
		do dbr.apps.action.pos(res)
		do dbr.commit(db)
		do dbr.apps.action.ext(res)
		
		return res

        exception
		{
			do errordet(@false)
			if dbr.in_transaction(db){ do dbr.rollback(db) }
			do dbr.apps.action.log()
			do cu_error("divisa")
			do rise_error(last_error_code(),last_error())
		}
    }

    function update(&db,&params,data)
    {
		@use_transaction = @false

		do dbr.apps.action.pre("XB102")
		do dbr.begin(db)

        if @@(data,"tcambio")==""
        {
            do field.remove(data,"tcambio")
        }
        ref res = entity.update(db,params,data)
		
		do dbr.apps.action.pos(res)
		do dbr.commit(db)
		do dbr.apps.action.ext(res)
		
		return res
		
		exception
		{
			do errordet(@false)
			if dbr.in_transaction(db){ do dbr.rollback(db) }
			do dbr.apps.action.log()
			do cu_error("divisa")
			do rise_error(last_error_code(),last_error())
		}
    }

    function delete(&db,&params)
	{
		@use_transaction = @false

		do dbr.apps.action.pre("XB103")
		do dbr.begin(db)
		
        ref res = entity.delete(db, params)
		
		do dbr.apps.action.pos(res)
		do dbr.commit(db)
		do dbr.apps.action.ext(res)
		
		return res

		exception
		{
			do errordet(@false)
			if dbr.in_transaction(db){ do dbr.rollback(db) }
			do dbr.apps.action.log()
			do rise_error(last_error_code(),last_error())
		}
	}
    
    point @list to divisa.list
    point @read to divisa.read
    point @blank to divisa.blank
    point @create to divisa.create
    point @update to divisa.update
    point @delete to divisa.delete
}