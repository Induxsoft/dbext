                "varname": "FXCA021",
                "vardefault": "2",
                "varvalue": "2",
                "varcaption": "Cálculo de porcentajes de descuentos.",
                "varhelp": "Método de cálculo de porcentajes de descuentos comerciales.",
                "vartype": "integer",
                "varinput": {
                    "control": "select",
                    "source":{
                        "type":"list",
                        "values":[
                            {"val":"1", "text":"Método 1 (Base - (Base * Porcentaje * 0.01))"},
                            {"val":"2", "text":"Método 2 (Base / (1 + (Porcentaje * 0.01)))"}
                        ],
                        "showfield":"text",
                        "keyfield":"val"
                    }
                }
            },
