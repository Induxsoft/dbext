#include "ddm.dkh"
model "Variables globales"
{
    #include "induxsoft.abstracts.ddm"

    abstract "NmModel"
    {
        @"sys_pk" int key required autoincrement
        @"sys_timestamp" datetime required
        @"sys_recver" int
        @"sys_deleted" bool
        @"sys_lock" int
    }

    //#region Usuarios, grupos, perfiles y permisos
    // Usuarios
    entity "tuser"
    {
        @"sys_pk" int key required autoincrement
        @"sys_guid" string(32) unique required
        @"sys_dtcreated" datetime
        @"sys_timestamp" datetime required
        @"sys_info" string(32)
        @"sys_user" string(32)
        @"sys_lastuser" string(32)
        @"sys_exported" bool
        @"sys_dtexported" datetime
        @"sys_recver" int
        @"sys_deleted" bool
        @"sys_lock" int

        @"locked" bool 
        @"message" string(255) 
        @"notes" memo 
        @"pwd" string(32) 
        @"userid" string(120) unique required
        @"username" string(120) required
        @"pwdmd5" string(64) 
    }
    // Grupo de usuarios
    entity "usergroup"
    {
        @"sys_pk" int key required autoincrement
        @"sys_guid" string(32) unique required
        @"sys_dtcreated" datetime
        @"sys_timestamp" datetime required
        @"sys_info" string(32)
        @"sys_user" string(32)
        @"sys_lastuser" string(32)
        @"sys_exported" bool
        @"sys_dtexported" datetime
        @"sys_recver" int
        @"sys_deleted" bool
        @"sys_lock" int

        @"description" string(80) required
        @"groupid" string(15) unique required
        @"notes" memo 
        @"uf_hidetoolbar" string(1) 
    }
    // Relacion entre usuarios y los grupos a los que pertenece
    entity "user_usergroup_" : "NmModel"
    {
        @"groups" int ref:"usergroup" ["sys_pk"] required
        @"users" int ref:"tuser" ["sys_pk"] required
    }
    // Permisos disponibles
    entity "sitem"
    {
        @"sys_pk" int key required autoincrement
        @"sys_guid" string(32) unique required
        @"sys_dtcreated" datetime
        @"sys_timestamp" datetime required
        @"sys_info" string(32)
        @"sys_user" string(32)
        @"sys_lastuser" string(32)
        @"sys_exported" bool
        @"sys_dtexported" datetime
        @"sys_recver" int
        @"sys_deleted" bool
        @"sys_lock" int

        @"description" string(250) 
        @"itemid" string(32) unique required
        @"itemparent" int ref:"sitem" ["sys_pk"] 
    }
    // Permisos que tiene un grupo de usuario
    entity "profile"
    {
        @"sys_pk" int key required autoincrement
        @"sys_guid" string(32) unique required
        @"sys_dtcreated" datetime
        @"sys_timestamp" datetime required
        @"sys_info" string(32)
        @"sys_user" string(32)
        @"sys_lastuser" string(32)
        @"sys_exported" bool
        @"sys_dtexported" datetime
        @"sys_recver" int
        @"sys_deleted" bool
        @"sys_lock" int

        @"item" int ref:"sitem" ["sys_pk"] required
        @"usergroup" int ref:"usergroup" ["sys_pk"] required

        index "iug_u" unique
        {
            field "item"
            field "usergroup"
        }
    }
    // Valores del usuario
    entity "uservar"
    {
        @"sys_pk" int key required autoincrement
        @"sys_guid" string(32) unique required
        @"sys_dtcreated" datetime
        @"sys_timestamp" datetime required
        @"sys_info" string(32)
        @"sys_user" string(32)
        @"sys_lastuser" string(32)
        @"sys_exported" bool
        @"sys_dtexported" datetime
        @"sys_recver" int
        @"sys_deleted" bool
        @"sys_lock" int

        @"vardefault" string(255) 
        @"varname" string(32) unique required
        @"varvalue" string(32000) 
        @"fuser" int ref:"tuser" ["sys_pk"] required
    }
    //#endregion

    // Categorías jerárquicas de variables
    entity "varcategory"
    {
        @"id" string(32) key
        @"caption" string(150) required
        @"help" memo
        @"parent" ref: "varcategory"
    }

    // Variables globales
    entity "globalvar"
    {
        @"sys_pk" int key required autoincrement
        @"sys_guid" string(32) unique required
        @"sys_dtcreated" datetime
        @"sys_timestamp" datetime required
        @"sys_info" string(32)
        @"sys_user" string(32)
        @"sys_lastuser" string(32)
        @"sys_exported" bool
        @"sys_dtexported" datetime
        @"sys_recver" int
        @"sys_deleted" bool
        @"sys_lock" int

        @"varname" string(32) unique required
        @"vardefault" string(255)
        @"varvalue" mmemo
        @"varcaption" string    // Etiqueta de la variable
        @"varhelp" memo         // Ayuda o información adicional
        @"vartype" string(15)   // Tipo de dato: string,integer,decimal,bool,date,datetime,time
        @"varinput" memo        // Json con especificaciones al tipo de control de entrada: null or 'default', color, select,inputkey,dkl,json,textarea
        @"ref_varcat" ref: "varcategory" // Categoría de variable
        @"userenable" bool // Si es true, la variable puede establecerse por usuario
    }

    // Variables del usuario
    entity "uservarval"
    {
        @"sys_pk" int key required autoincrement
        @"sys_guid" string(32) unique required
        @"sys_dtcreated" datetime
        @"sys_timestamp" datetime required
        @"sys_info" string(32)
        @"sys_user" string(32)
        @"sys_lastuser" string(32)
        @"sys_exported" bool
        @"sys_dtexported" datetime
        @"sys_recver" int
        @"sys_deleted" bool
        @"sys_lock" int

        @"varname" string(32) required
        @"varvalue" mmemo 
        @"userid" string(45) required
        index "uv_u" unique
        {
            field "varname"
            field "userid"
        }
    }

    //Controladores de eventos 
    entity "sys_event_handlers" 
    {
        @"sys_pk" int autoincrement key 
        @"created" datetime required
        @"sender_id" string(50) required
        @"sequence" int
        @"include_script" string(255) required

        index "seh_u" unique
        {
            field "sender_id"
            field "include_script"
        }
    }

    // Información de la aplicación
    entity "sys_app_catalog"
    {
        @"pack_id" string(32) required
        @"app_id" string(32) key
        @"app_title" string(255)
        @"created" datetime required
        @"app_info" mmemo
    }
    // Categoria de la aplicación
    entity "sys_app_category"
    {
        @"id" string(32) key
        @"title" string(255) required
    }
    // Recursos de la aplicación
    entity "sys_app_shortcut" 
    {
        @"id" string(32) key
        @"title" string(255) required
        @"icon96x96" string(1024) required
        @"href" string(1024) required
        @"_blank" bool
        @"appid" ref : "sys_app_catalog"
        @"cat" ref :"sys_app_category"
    }

    entity "sys_app_action"
    {
        @"id" string(32) key
        @"title" string(255) required
        @"icon16x16" string(1024) required
        @"href" string(1024) required
        @"_blank" bool
        @"appid" ref : "sys_app_catalog"
        @"context" ref : "sys_app_action_context"
        @"req_context_item_id" bool
        @"act_type" string(15) //Cadena con el tipo de acción: 'action' o 'report'
    }

    entity "sys_app_action_context"
    {
        @"id" string(32) key
        @"title" string(255) required
    }

    //Folios
    entity "cdocumentos" : "EnumModel" {}

    entity "blockdocumentos" : "TableModel"
    {
        @"activo" bool required
        @"datos" string(255)
        @"documento" ref:"cdocumentos" required
        @"finicial" int required
        @"fiscal" bool required
        @"fultimo" int required
        @"idcontrol" string(32)
        @"numcontrol" int
        @"serie" string(10)
        @"uf_cfdfolio" int
        @"uf_cfdi_info" int
    }

    entity "foliosdocumentos" : "TableModel"
    {
        @"cancelado" bool required
        @"fecha" date required
        @"folio" int required
        @"block" ref:"blockdocumentos" required

        index "idx_foliodoc" unique
        {
            field "folio"
            field "block"
        }
    }
}