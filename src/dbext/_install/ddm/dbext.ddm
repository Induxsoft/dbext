#include "ddm.dkh"
model "Variables globales"
{
    #include "induxsoft.abstracts.ddm"

    abstract "NmModel"
    {
        @"sys_pk" int key required autoincrement
        @"sys_timestamp" datetime required
        @"sys_recver" int
        @"sys_deleted" bool
        @"sys_lock" int
    }

    // Tipos de documentos comerciales
    entity "cdocumentos" : "EnumModel" {}

    entity "jobsgroup" : "TableModel"
    {
        @"name" string (150) unique required
        @"apikey" string (32) required // Digestión MD5 de la contraseña del grupo de trabajo
    }

    //#region Usuarios, grupos, perfiles y permisos
    // Usuarios
    entity "tuser" : "TableModel"
    {
        @"sys_info" string(120)

        @"locked" bool 
        @"message" string(255) 
        @"notes" memo 
        @"pwd" string(32) 
        @"userid" string(120) unique required
        @"username" string(120) required
        @"pwdmd5" string(64) 

        @"external" bool    //Si es true, el usuario se consiera externo
    }
    // Grupo de usuarios
    entity "usergroup" : "TableModel"
    {
        @"description" string(80) required
        @"groupid" string(32) unique required
        @"notes" memo 
        @"uf_hidetoolbar" string(1) 
    }
    // Relacion entre usuarios y los grupos a los que pertenece
    entity "user_usergroup_" : "NmModel"
    {
        @"groups" ref:"usergroup" required
        @"users" ref:"tuser" required
    }
    // Permisos disponibles
    entity "sitem" : "TableModel"
    {
        @"description" string(250) 
        @"itemid" string(32) unique required
        @"itemparent" ref:"sitem" 
    }
    // Permisos que tiene un grupo de usuario
    entity "profile" : "TableModel"
    {
        @"item"  ref:"sitem"  required
        @"usergroup"  ref:"usergroup"  required

        index "iug_u" unique
        {
            field "item"
            field "usergroup"
        }
    }
    // Valores del usuario
    entity "uservar" : "TableModel"
    {
        @"vardefault" string(255) 
        @"varname" string(32) unique required
        @"varvalue" string(32000) 
        @"fuser" ref:"tuser" required
    }
    //#endregion

    // Categorías jerárquicas de variables
    entity "varcategory"
    {
        @"id" string(32) key
        @"caption" string(150) required
        @"help" memo
        @"parent" ref:"varcategory"
    }
    // Variables globales
    entity "globalvar" : "TableModel"
    {
        @"varname" string(32) unique required
        @"vardefault" string(255)
        @"varvalue" mmemo
        @"varcaption" string(50) // Etiqueta de la variable
        @"varhelp" memo // Ayuda o información adicional
        @"vartype" string(15) // Tipo de dato: string,integer,decimal,bool,date,datetime,time
        @"varinput" memo // Json con especificaciones al tipo de control de entrada: null or 'default', color, select,inputkey,dkl,json,textarea
        @"ref_varcat" ref:"varcategory" // Categoría de variable
        @"userenable" bool // Si es true, la variable puede establecerse por usuario
    }
    // Variables del usuario
    entity "uservarval" : "TableModel"
    {
        @"varname" string(32) required
        @"varvalue" mmemo 
        @"userid" string(45) required
        
        index "uv_u" unique
        {
            field "varname"
            field "userid"
        }
    }
    // Administración de series de documentos
    entity "blockdocumentos" : "TableModel"
    {
        @"activo" bool required
        @"datos" string(255)
        @"documento" ref:"cdocumentos" required
        @"finicial" int required
        @"fiscal" bool required
        @"fultimo" int required
        @"idcontrol" string(32)
        @"numcontrol" int
        @"serie" string(10)
        @"uf_cfdfolio" int
        @"uf_cfdi_info" int
    }
    // Control de folios de documentos
    entity "foliosdocumentos" : "TableModel"
    {
        @"cancelado" bool required
        @"fecha" date required
        @"folio" int required
        @"block" ref:"blockdocumentos" required

        index "idx_foliodoc" unique
        {
            field "folio"
            field "block"
        }
    }
    // Catálogo de monedas o divisas
    entity "divisa" : "TableModel"
    {
        @"codigo" string(5) unique required
        @"descripcion" string(30) unique required
        @"tcambio" decimal(18,8)
        @"decimales" int
    }
    entity "idioma" : "TableModel"
    {
        @"nombre" string(50) required   
        //https://es.wikipedia.org/wiki/ISO_639-1
        @"iso639_1" string(2) required unique
    }

    //#region Domicilio
    entity "pais" : "TableModel"
    {
        @"codigo" string(8) unique required
        @"nombre" string(100) unique required

        @"th_sep" string(3)
        @"dc_sep" string(3)
        //https://es.wikipedia.org/wiki/ISO_3166-1
        @"iso3166" string(2) unique
        @"iso3166_a3" string(3) unique
        //https://es.wikipedia.org/wiki/Anexo:Prefijos_telef%C3%B3nicos_mundiales
        @"codigotel" string(5)
    }
    entity "edoprov" : "TableModel"
    {
        @"codigo" string(8) unique required
        @"nombre" string(50) required
        @"ipais" ref:"pais" required
    }
    entity "ciudad" : "TableModel"
    {
        @"codigo" string(8) unique required
        @"codigotel" string(5)
        @"nombre" string(100) required
        @"estado" ref:"edoprov" required
    }
    entity "domicilio" : "TableModel"
    {
        @"codpos" string(10)
        @"colonia" string(150)
        @"direccion" string(1024)
        @"notas" string(150)
        @"telefonos" string(150)
        @"iciudad" ref:"ciudad"
        @"numint" string(1024)
        @"numext" string(1024)
    }
    //#endregion

    entity "snd_provider_tpy" : "EnumModel"
    {
        //0-E-Mail
        //1-TEXT
        //2-IM
    }

    entity "snd_provider" : "TableModel"
    {
        @"name" string(32) unique required
        @"tpy" ref:"snd_provider_tpy" required
        @"entry_point" string(256)  // URL relativa de acceso a los controles del proveedor
        @"lib" string(256) required // Ruta hacia la biblioteca que implementa las funciones de la interfaz
    }

    entity "snd_channel" : "TableModel"
    {
        @"prov" ref:"snd_provider" required
        @"name" string(32) unique required
        @"config" mmemo
    }

    entity "det_usr" : "TableModel"
    {
        @"ref_user" ref:"tuser" required
        @"ref_det" ref:"sys_app_item_type" required
        @"detid" int required //Clave primaria del DET en específico
        @"detinfo" string(150)
        
        index "det_usr_uq1" unique
        {
            field "ref_user"
            field "ref_det"
            field "detid"
        }
    }

    entity "sitem_det_usr" : "TableModel"
    {
        @"ref_det_usr" ref:"det_usr" required
        @"itemid" string ref:"sitem" ["itemid"] required
        
        index "sitem_det_usr_uq1" unique
        {
            field "ref_det_usr"
            field "itemid"
        }
    }

    entity "dba_query_cat":"TableModel"
    {
        @"id" string(25) unique required
        @"title" string(100) required
    }
    
    entity "dba_query":"TableModel"
    {
        @"actid" string(25) unique required
        @"id" string(25) unique required
        @"title" string(255) required
        @"parameters" memo
        @"properties" memo
        @"qry" mmemo
        @"design" memo
        @"cat" ref:"dba_query_cat" required
        @"app" ref:"sys_app_catalog"
        @"det" ref:"sys_app_item_type"
    }

    //#region sys_*
    // Catálogo de aplicaciones de paquetes (información de la aplicación)
    entity "sys_app_catalog"
    {
        @"pack_id" string(32) required
        @"app_id" string(32) key
        @"app_title" string(255)
        @"created" datetime required
        @"app_info" mmemo
    }
    // Categoria de aplicaciones
    entity "sys_app_category"
    {
        @"id" string(32) key
        @"title" string(255) required
    }
    // Tipos de elementos de las aplicaciones
    entity "sys_app_item_type"
    {
        @"id" string(32) key
        @"title" string(255) required
        @"view_url" string(1024) //URL de consulta, en donde @_entity_id representa el id del elemento
    }
    // Buscadores por Tipo de Elemento de Datos
    entity "sys_app_item_type_finder"
    {
        @"det" ref:"sys_app_item_type" required 
        @"class" string(45) required // * -Valor por defecto
        @"sql_query" memo required
        @"keyfield" string(45) required
        @"textfield" string(45) required
        @"primarykey" string(45) required
        
        index "sys_app_item_type_finder_idx1" unique
        {
            field "det"
            field "class"
        }
    }
    // Accessos a las aplicaciones de paquetes
    entity "sys_app_shortcut" 
    {
        @"id" string(32) key
        @"title" string(255) required
        @"icon96x96" string(1024) required
        @"src" string(1024) required //cambiar a href
        @"_blank" bool
        @"appid" ref : "sys_app_catalog"
        @"cat" ref :"sys_app_category"
    }
    // Acciones Generales o Especificas de elementos de la aplicación
    entity "sys_app_item_action"
    {
        @"id" string(32) key
        @"title" string(255) required
        @"shorttitle" string(25) 
        @"icon16x16" string(1024) required
        @"href" string(1024) required
        @"_blank" bool
        @"appid" ref : "sys_app_catalog"
        @"itemtype" ref : "sys_app_item_type"
        @"req_context_item_id" bool
        @"act_type" string(15) //Cadena con el tipo de acción: 'action' o 'report'
    }
    // Controladores de eventos 
    entity "sys_event_handlers" 
    {
        @"sys_pk" int autoincrement key 
        @"created" datetime required
        @"sender_id" string(50) required
        @"sequence" int
        @"include_script" string(255) required

        index "seh_u" unique
        {
            field "sender_id"
            field "include_script"
        }
    }
    // Relación entre dos instancias de tipos de elementos de datos
    entity "sys_dte_rel": "TableModel"
    {
        @"dte1" ref:"sys_app_item_type" required
        @"id1" int required
        @"ref1" string(50)
        @"dte2" ref:"sys_app_item_type" required
        @"id2" int required
        @"ref2" string(50)
        @"text" string(128)
        
        index "sys_dte_rel_uq1"
        {
            field "dte1"
            field "id1"
            field "dte2"
            field "id2"
        }
    }
    entity "sys_group_app_shortcut"
    {
        @"shortcut" ref:"sys_app_shortcut" required
        @"usergroup" ref:"usergroup" required

        index "sys_group_app_shortcut_idx1" unique
        {
            field "shortcut"
            field "usergroup"
        }
    }
    /*
    * Tipos de requerimientos de autorizaciones
    * 0-Read
    * 1-Create
    * 2-Update
    * 3-Delete
    */
    entity "sys_auth_tpy" : "TableModel" 
    {
        @"id" string(32) unique required
        @"text" string(50) required
        @"view" lmemo required //Código Dkl de la vista estática para este tipo de entidades
        @"usergroup" ref:"usergroup" required
        @"min_users" int required // Valor mínimo admitido=1, indica la cantidad de usuarios diferentes del grupo que deben autorizar
        @"masteruser" ref:"tuser" // Usuario maestro, puede conceder la autorización sin pertenecer al grupo o  sin reunir la cantidad
        @"autologin" bool //Si es true, se crea una nueva sesión para el usuario solicitante si cuando se realiza la autorización no tiene una sesión activa
    }
    // Bitácora de autorizaciones
    entity "sys_auth_log" : "TableModel" 
    {
        @"tpy" ref : "sys_auth_tpy" required
        @"operation" string(15) required
        @"transid" string(32) required
        @"http_request" lmemo required
        @"http_response" lmemo required
        @"req_user" ref : "tuser"
        @"note" memo
        @"authorized" bool
        @"rejected" bool //rechazada
        @"rejby" ref:"tuser" //user rechazo
        @"redir" string(1024)
        @"cancel" bool
        @"error" bool
        @"error_info" mmemo
        @"executed" datetime
        
        index "sys_auth_log_i1" // Índice no único
        {
            field "transid"
            field "tpy"
            field "operation"
        }
    }
    entity "sys_auth_log_usr" : "TableModel" 
    {
        @"log" ref:"sys_auth_log" required
        @"auth_user" ref : "tuser"
        @"note" memo
        @"authorized" bool
        @"cancel" bool
        @"rejected" bool
        @"asmaster" bool

        index "sys_auth_log_usr_idx" unique
        {
            field "log"
            field "auth_user"
        }
    }
    // Registro de acciones ejecutadas por los usuarios
    entity "sys_action_log"
    {
        @"id" int key required autoincrement
        @"ts" datetime required
        @"action" string(32) 
        @"element" string(32)
        @"element_id" int
        @"path" string(512)
        @"user" string(50)
        @"denied" bool
        @"unauth" bool
        @"error" bool
        @"error_message" memo
        @"context" lmemo
    }
    // Catálogo de alias de privilegios
    entity "sys_priv_alias"
    {
        @"priv_id" string(45) required
        @"priv_id_alias" string(45) required

        index "sys_priv_alias_uq1" unique
        {
            field "priv_id"
            field "priv_id_alias"
        }
    }
    //#endregion
}