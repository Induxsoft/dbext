#include "dkli.dkh"
#!
module ":lib"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "webcl.dkh"

    function sendMessage(&config, &message, &remplace_template)
    {
        new payload
        {
            @"template_id": @@(message, "$template_id")
            @"template_vars*": remplace_template
            @"queue": @@(config,"$queue")
        }

        endpoint = "https://agent.induxsoft.net/svc/{agent_id}/send/whatsapp/?to={to}"
        endpoint = replace(endpoint, "{agent_id}", @@(config,"$agent_id"))
        endpoint = replace(endpoint, "{to}", @@(message,"$to"))

        if not(@@(message, "$ids") == "")
        {
            endpoint = endpoint + "&ids=" + @@(message, "$ids")
        }

        new headers
        {
            @"Authorization": "Bearer " +  @@(config,"$secret")
            @"Content-Type": "application/json"
        }

        response = http.request(endpoint, "POST", headers, to.json(payload))
        
        return from.json(response)
    }
}