#include "dkli.dkh"
#!
module "controller"
{
    switch @@(@http_context,"$request/get/_view")
    {
        case "proveedor"
        {
            @table_name = "snd_provider"
            point @list to buscar_proveedor
            break
        }
        case "light_provider"
        {
            @table_name = "snd_channel"
            point @update to update_light_channel
            point @read to read_light_channel
            break
        }
    }
}