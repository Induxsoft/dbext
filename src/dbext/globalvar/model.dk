#include "dkli.dkh"
#!
module "model"
{
    #include "../config.dk"
    #include "dbr.attachment.dkl"

    @table_name = "globalvar"

    function load_query_values(&db,&params)
    {
        
        ref rec=dbr.rec(db,"select ifnull(varinput,'{}') varinput from globalvar where varname=@varname",params)
        if not(isnull(rec))
        {
            if trim(rec.varinput)=="" { rec.varinput:="{}" }
            ref d=from.json(rec.varinput)
            sql=@@(d,"$source/query")
            if sql!="" { return dbr.list(db,sql,@null)} 
        }

        return list.create()
    }

    function globalvar_read(&db, &params)
    {
        // if not(dbr.security.isauth(db,@AUT_READ_GVAR)) { do rise_error(500,"No autorizado") }
        do dbr.apps.action.grant("XB40")

        return get_category_vars(db, params)

        exception
        {
            do errordet(@false)
            do dbr.apps.action.log()
            do rise_error(last_error_code(),last_error())
        }
    }

    function globalvar_list(&db, &params)
    {
        do dbr.apps.action.grant("XB40")

        sql = "SELECT IFNULL(id,'') id, IFNULL(caption,'') caption, IFNULL(help,'') help, IFNULL(parent,'') parent FROM varcategory ORDER BY caption;"
        return dbr.list(db, sql, @null)

        exception
        {
            do errordet(@false)
            do dbr.apps.action.log()
            do rise_error(last_error_code(),last_error())
        }
    }
    
    function get_category_vars(&db, &category)
    {
        sql = "
        SELECT
            sys_pk,
            sys_recver,
            IFNULL(vardefault,'') vardefault,
            varname,
            IFNULL(varvalue,'') varvalue,
            IF(IFNULL(varcaption,'')='',
                varname,
                CONCAT(varcaption,' (',varname,')')
            ) AS varcaption,
            IF(IFNULL(varcaption,'')='',
                varname,
                varcaption
            ) AS caption,
            IFNULL(varhelp,'') varhelp,
            IFNULL(vartype,'') vartype,
            IFNULL(varinput,'{}') varinput
        FROM globalvar
        WHERE IFNULL(ref_varcat,'#<@id_vars_without_cat>')=@_entity_id;
        "
        return dbr.list(db, ftext(sql), category)
    }

    function globalvar_create(&db, &params, &data)
    {
        ref vars = @@(data, "&vars")
        
        if not(isnull(vars)) && list.count(vars) > 0
        {
            for i = 0; i < list.count(vars)
            {
                ref var = list.obj(vars, i)
                ref v= dbr.save(db, "globalvar", var)
                var<"sys_recver">:@@(v,"#sys_recver")+1
            }
        }

        return vars
    }

    function create(&db,&params,&data)
    {
        @use_transaction = @false

        do dbr.apps.action.pre("XB41")
        do dbr.begin(db)
        
        do SaveFiles(db,params,data)

        ref result = globalvar_create(db,params,data)

        do dbr.apps.action.pos(result)
        do dbr.commit(db)
        do dbr.apps.action.ext(result)

        return result

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db){ do dbr.rollback(db) }
            do dbr.apps.action.log()
            do rise_error(last_error_code(),last_error())
        }
    }

    function update(&db,&params,&data)
    {
        @use_transaction = @false
        
        do dbr.apps.action.pre("XB42")
        do dbr.begin(db)
        
        do SaveFiles(db,params,data)
        ref result = globalvar_create(db,params,data)

        do dbr.apps.action.pos(result)
        do dbr.commit(db)
        do dbr.apps.action.ext(result)

        return result

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db){ do dbr.rollback(db) }
            do dbr.apps.action.log()
            do rise_error(last_error_code(),last_error())
        }
    }

    function delete(&db,&params)
    {
        do rise_error(500,"Acción no implementada")
    }

    function SaveFiles(&db,&params,&data)
    {
        pathfile=dbr.vars.get(db,"dbext_public_content_storage")
        urlfile=dbr.vars.get(db,"dbext_public_content")

        pathfile=path.concat("web/",pathfile)
        @dbr.attachment.custom_path = pathfile
        @dbr.attachment.custom_url = urlfile

        ref files = ifnull(@@(@http_context,"&request/files"),list.create())

        filename=""
        if trim(@@(data,"$file_name"))!=""
        {
            for i = 0; i < list.count(files)
            {
                ref file = list.obj(files,i)
                if file.exists(@@(file,"$temp_file")) && @@(file,"$filename") != "" && @@(file,"#size") > 0
                {
                    filename=@@(file,"$filename")
                    file<"filename">:trim(@@(data,"$file_name"))+file.extension(@@(file,"$filename"))
                }
            }
        }
        
        do dbr.attachment.upload(params)
        new var
        {
            @"varname":trim(@@(data,"$file_name"))
            @"varvalue":filename
        }
        do dbr.update(db,"globalvar",var,"varname=@varname",var)
    }
    point @read to globalvar_read
    point @list to globalvar_list
    point @create to create
    point @update to update
    point @delete to delete
}