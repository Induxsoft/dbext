#include "dkli.dkh"
#!
module "list"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "../config.dk"

    do @context.begin(@crud_context)
    ref categories = @("&./")

    new withoutCategory
    {
        @"id": @id_vars_without_cat
        @"caption": "Sin categorizar"
        @"help": "Variables sin categoría asignada"
        @"parent":""
    }

    do list.add(categories, withoutCategory)

    #$ div
    {
        link(rel="stylesheet" href="#<@CSS_MAIN>")
        link(rel="stylesheet" href="#<@CSS_GLOBALVAR>")

        div(id="mainContainer")
        {
            div(id="SectionOne")
            {
                div
                {
                    div(class="d-flex align-items-center border-bottom bg-white px-2 section-bar")
                    {
                        small(class="text-secondary"){$"Categorías de configuración"}
                    }
                    div
                    {
                        div(style="max-height: 80vh;display: flex;")
						{
							"edit-table"(id="treeCategories" data='#<to.json(categories)>' "show-tree"="true" parentkey="parent" key="id" "can-move-row"="false" style="width: 100%;" "control-styles"="tr td{font-size:.8rem;} th{font-size:.9rem; outline: none !important; font-weight:500 !important;} #__table_input{ font-size: unset !important; }")
							{
								"edit-thead"
								{
									"edit-tr"
									{
										"edit-th"(type="NoEditable" field="caption" style="text-align:start;"){$"Categorías"}
									}
								}
							}
						}
                    }
                }
                div(id="ajust_panel_one"){ $"" }
            }
            div(id="sectionTwo")
            {
                div(class="border-bottom bg-white")
                {
                    div(class="d-flex align-items-center border-bottom px-2 section-bar")
                    {
                        small(class="text-secondary"){$"Información de la categoría"}
                    }
                    div(class="py-2 px-3 d-flex gap-2" id="categoryInfo")
                    {
                        small(class="text-secondary"){$"Selecciona una categoría."}
                    }
                }
                div(class="border-bottom bg-white d-flex justify-content-between")
                {
                    div(class="d-flex align-items-center px-2 section-bar")
                    {
                        small(class="text-secondary"){$"Variables de configuración"}
                    }
                    div(class="d-flex align-items-center" id="vars_controls")
                    {
                        button(class="control btn btn-sm d-flex align-items-center justify-content-center gap-2 no-shadow hidde-control d-none" title="Guardar cambios" id="save_changes"){
                            $"#<@@(@icons,'save')>"
                            small{$"Guardar"}
                        }
                        button(class="control btn btn-sm d-flex align-items-center justify-content-center gap-2 no-shadow hidde-control d-none" title="Descartar cambios" id="undo_changes"){
                            $"#<@@(@icons,'discard')>"
                            small{$"Descartar"}
                        }
                    }
                }
                div(class="p-4")
                {
                    h5(class="mb-3"){$"Opciones"}
                    div(id="varsFormControls" class="d-none")
                    {
                        $"Formularios"
                    }
                    div(class="d-flex h-100 w-100 align-items-center justify-content-center" id="varsEmpty" style="min-height: 50vh;")
                    {
                        small(class="text-secondary"){$"No hay información de la categoría especificada."}
                    }
                }
            }
        }
        #$
        script(src="#<@JS_MAIN>"){$""}
        script(src="#<@JS_GLOBALVAR>"){$""}
        script{$'
            globalvar.tableCId = "treeCategories";
            globalvar.url = "#<@DBEXT_ADD_EDIT_GLVAR>";
        '}
    }
}