module ":dbr.apps"
{
    // Agrega o actualiza la información de una categoría de aplicaciones
    category.set::&db,&data
    {
        //sys_app_category
        return dbr.execute(db, "INSERT INTO sys_app_category VALUES (@id, @title) ON DUPLICATE KEY UPDATE id=@id, title=@title;", data)
    }

    // Devuelve todas las categorías de aplicaciones
    categories::&db
    {
        return dbr.list(db,"select id, title from sys_app_category order by id;",@null)
    }

    // Elimina una categoría por su id
    category.delete::&db,id
    {
        new prm { @"id": id }
        return dbr.execute(db, "DELETE FROM sys_app_category WHERE id=@id", prm)
    }

    // Agregar o actualiza la información de una aplicación
    set::&db,&data
    {
        //sys_app_catalog
        return dbr.execute(db, "INSERT INTO sys_app_catalog VALUES (@pack_id, @app_id, @app_title, @created, @app_info) ON DUPLICATE KEY UPDATE pack_id=@pack_id, app_id=@app_id, app_title=@app_title, created=@created, app_info=@app_info;", data)
    }

    //Devuelve todas las aplicaciones
    list::&db
    {
        return dbr.list(db,"select * from sys_app_catalog order by app_id;",@null)
    }

    // Elimina una aplicación por su id
    delete::&db,id
    {
        new prm { @"id": id }
        return dbr.execute(db, "DELETE FROM sys_app_catalog WHERE app_id=@id", prm)
    }

