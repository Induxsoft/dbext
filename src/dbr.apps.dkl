#include "dkli.dkh"
#!
module ":dbr.apps"
{
    // Agrega o actualiza la información de un conjunto de categorias.
    category.import::&db,&list
    {
        for i = 0; i < list.count(list)
        {
            ref cat = list.obj(list,i)
            do dbr.apps.category.set(db,cat)
            do print("- " + @@(cat,"$title"))
        }
    }

    // Agrega o actualiza la información de un conjunto de aplicaciones.
    import::&db,&list
    {
        for i = 0; i < list.count(list)
        {
            ref app = list.obj(list,i)
            do dbr.apps.set(db,app)
            do print("- " + @@(app,"$app_title"))
        }
    }

    // Agrega o actualiza un conjunto de accesos directos.
    shortcut.import::&db,&list
    {
        for i = 0; i < list.count(list)
        {
            ref sct = list.obj(list,i)
            do dbr.apps.shortcut.set(db,sct)
            do print("- " + @@(sct,"$title"))
        }
    }

    // Agrega o actualiza un conjunto de tipos de elementos sobre el que aplican acciones.
    itemtype.import::&db,&list
    {
        for i = 0; i < list.count(list)
        {
            ref itm = list.obj(list,i)
            do dbr.apps.itemtype.set(db,itm)
            do print("- " + @@(itm,"$title"))
        }
    }

    // Agrega o actualiza un conjunto de acciones.
    itemaction.import::&db,&list
    {
        for i = 0; i < list.count(list)
        {
            ref act = list.obj(list,i)
            do dbr.apps.itemaction.set(db,act)
            do print("- " + @@(act,"$title"))
        }
    }

    // Agrega o actualiza la información de una categoría de aplicaciones
    category.set::&db,&data
    {
        //sys_app_category
        return dbr.apps.save(db, "sys_app_category", data)
    }

    // Devuelve todas las categorías de aplicaciones
    categories::&db
    {
        return dbr.list(db,"select id, title from sys_app_category order by id;",@null)
    }

    // Elimina una categoría por su id
    category.delete::&db,id
    {
        new prm { @"id": id }
        return dbr.execute(db, "DELETE FROM sys_app_category WHERE id=@id", prm)
    }

    // Agregar o actualiza la información de una aplicación
    set::&db,&data
    {
        //sys_app_catalog
        return dbr.apps.save(db, "sys_app_catalog", data)
    }

    //Devuelve todas las aplicaciones
    list::&db
    {
        return dbr.list(db,"select * from sys_app_catalog order by app_id;",@null)
    }

    // Elimina una aplicación por su id
    delete::&db,id
    {
        new prm { @"id": id }
        return dbr.execute(db, "DELETE FROM sys_app_catalog WHERE app_id=@id", prm)
    }

    //Agrega o actualiza un acceso directo
    shortcut.set::&db,&data
    {
        //sys_app_shortcut
        return dbr.apps.save(db, "sys_app_shortcut", data)
    }

    //Eliminar un acceso directo
    shortcut.delete::&db,id
    {
        new prm { @"id": id }
        return dbr.execute(db, "DELETE FROM sys_app_shortcut WHERE id=@id", prm)
    }

    // Devuelve una lista de accesos directos que corresponden al 
    // grupo indicado (por groupid o guid) o a todos los grupos si groupid="*" o al usuario conectado si groupid="" (cadena vacía)
    shortcuts::&db,groupid
    {
        // Si ningún grupo al que pertenece el usuario tiene accesos directos, se devuelven todos
        // Si al menos un grupo al que pertenece el usuario tiene acceso directos, se 
        new prm { 
            @"group_id": groupid 
            @"sesion_id": dbr.getSID(db)
        }
        sql = "
            SELECT DISTINCT sas.*, IFNULL(sas.cat,'__without__') category, IFNULL(sac.app_info,'') info
            FROM sys_app_shortcut sas
                LEFT JOIN sys_app_catalog sac ON sas.appid = sac.app_id
                LEFT JOIN sys_group_app_shortcut sgas ON sgas.shortcut = sas.id
                LEFT JOIN usergroup ug2 ON sgas.usergroup = ug2.sys_pk
                LEFT JOIN (
                    SELECT IFNULL(ug.sys_pk,-99) ug
                    FROM sys_session ss
                        LEFT JOIN tuser tu ON ss.iuser = tu.sys_pk
                        LEFT JOIN user_usergroup_ uug ON uug.users = tu.sys_pk
                        LEFT JOIN usergroup ug ON uug.groups = ug.sys_pk
                    WHERE ss.sys_guid = @sesion_id
                ) u ON true
            WHERE 
                IF(
                    @group_id='' AND u.ug NOT IN (SELECT usergroup FROM sys_group_app_shortcut), 
                    true,
                    IF(
                        @group_id='', 
                        u.ug = ug2.sys_pk, 
                        IF(
                            @group_id='*', 
                            true, 
                            ug2.groupid = @group_id OR ug2.sys_guid = @group_id
                        )
                    )
                )
            ORDER BY sas.id;
        "
        return dbr.list(db, sql, prm)
    }

    //Agrega o actualiza un tipo de elemento sobre el que aplican acciones
    itemtype.set::&db,&data
    {
        //sys_app_item_type
        return dbr.apps.save(db, "sys_app_item_type", data)
    }

    //Elimina un tipo de elemento sobre el que aplican acciones
    itemtype.delete::&db,id
    {
        //sys_app_item_type
        new prm { @"id": id }
        return dbr.execute(db, "DELETE FROM sys_app_item_type WHERE id=@id", prm)
    }

    //Obtiene una lista de todos los tipos de elementos
    itemtypes::&db
    {
        //sys_app_item_type
        return dbr.list(db,"select id, title from sys_app_item_type order by id;",@null)
    }

    //Agrega o actualiza una acción
    itemaction.set::&db,&data
    {
        //sys_app_item_action
        if not(field.exist(data,"icon16x16")){data<"icon16x16">:""} //El campo es requerido en la base de datos
        return dbr.apps.save(db, "sys_app_item_action", data)
    }

    //Elimina una acción
    itemaction.delete::&db,id
    {
        //sys_app_item_action
        new prm { @"id": id }
        return dbr.execute(db, "DELETE FROM sys_app_item_action WHERE id=@id", prm)
    }

    //Obtiene una lista de todas las acciones asociadas a un tipo de elemento
    //Si iditemtype="*" devuelve todas las acciones
    //Si acttype="*" no aplica el filtro por tipo de acción ('action' o 'report')
    //Si text=="" no se aplica el filtro like por el id, titulo de la acción, tipo de elemento o shortcut
    //req==0 Devolver todas las acciones, ==1 req_context_item_id=false (or null) y ==2 req_context_item_id=true
    //req==1 and iditemtype="*" mostrar los campos del shortcut
    itemactions::&db, iditemtype, acttype, text, req
    {
        //sys_app_item_action
        new prm {
            @"item_type": iditemtype
            @"act_type": acttype
            @"text": text
            @"req": req
        }

        sql = ""

        if @@(prm,"#req") == 1 && @@(prm,"item_type") == "*"
        {
            sql = "
                SELECT * FROM
                (
                    (SELECT sh.id, sh.title, SUBSTRING(sh.title,1,25) shorttitle, sh.icon96x96 icon, sh.src href, sh._blank, sh.appid, '*' itemtype, 0 req_context_item_id,'shortcut' act_type FROM sys_app_shortcut sh)
                    UNION ALL
                    (SELECT ia.id, ia.title, ia.shorttitle, ia.icon16x16 icon, ia.href, ia._blank, ia.appid, ia.itemtype, ia.req_context_item_id, ia.act_type FROM sys_app_item_action ia WHERE NOT IFNULL(ia.req_context_item_id,0))
                ) v
                WHERE IF(@act_type='*', true, v.act_type=@act_type)
                    AND IF(@text='', true, (v.id LIKE CONCAT('%',@text,'%') OR v.title LIKE CONCAT('%',@text,'%')))
                ORDER BY v.id;
            "
        }
        else 
        {
            sql = "
                SELECT ia.id, ia.title, ia.shorttitle, ia.icon16x16 icon, ia.href, ia._blank, ia.appid, ia.itemtype, ia.req_context_item_id, ia.act_type
                FROM sys_app_item_action ia
                    LEFT JOIN sys_app_item_type it ON ia.itemtype = it.id
                WHERE IF(@item_type='*', true, ia.itemtype=@item_type)
                    AND IF(@act_type='*', true, ia.act_type=@act_type)
                    AND IF(@text='', true, (ia.id LIKE CONCAT('%',@text,'%') OR ia.title LIKE CONCAT('%',@text,'%') OR it.title LIKE CONCAT('%',@text,'%')))
                    AND IF(@req=0, true, @req=(IFNULL(req_context_item_id,0)+1))
                ORDER BY ia.id;
            "    
        }
        
        return dbr.list(db, sql, prm)
    }

    save::&db,tablename,&data
    {
        ref fields=list.create_from_fields(data)
        str_fields=replace(ranychars(to.json(fields),'[]{}"', " ")," ","")

        sql="INSERT INTO "+tablename+" ("+str_fields+") VALUES ("

        for i=0; i<list.count(fields) {
            if i>0 { sql=sql+"," }
            sql=sql+"@"+list.str(fields,i)
        }

        sql=sql+") ON DUPLICATE KEY UPDATE "

        for i=0; i<list.count(fields) {
            field=list.str(fields,i)
            if i>0 { sql=sql+"," }
            sql=sql+field+"=@"+field
        }

        sql=sql+";"
        return dbr.execute(db, sql, data)
    }
}
