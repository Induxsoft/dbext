#include "dkli.dkh"
#!
module "Variables alojadas en la base de datos :dbr.vars"
{
    #include "serialize.dkh"
    // Obtiene y establece si no se ha establecido previamente, 
    // un identificador único que puede usarse para comparar dos conexiones
    // y determinar si corresponden a la misma base de datos

    db_id::&db
    {
        id=dbr.vars.get(db,"_database_id")

        if id=="" 
        { 
            id=uuid()
            do dbr.vars.set(db,"_database_id",id)
        }

        return id
    }

    // Establece una variable global
    set::&db,varname,value
    {
        new p
        {
            @"varname":varname
            @"varvalue":value
        }

        ref rec=dbr.rec(db,"select * from globalvar where varname=@varname;",p)
        if isnull(rec)
        {
            ref rec=record.create()
            using rec
            {
                @"sys_guid":uuid()
                @"sys_dtcreated*":dbr.sql("now()")
                @"sys_timestamp*":dbr.sql("now()")
                @"sys_recver":0
                @"varname":varname
                @"varvalue":value
            }
            do dbr.insert(db,"globalvar",rec)
        }
        else
        {
            do dbr.execute(db,"update globalvar set varvalue=@varvalue where varname=@varname",p)
        }
        
    }

    userid::&db
    {
        new p { @"sid": dbr.getSID(db) }
        ref rec=dbr.rec(db,"select u.userid from tuser u inner join sys_session s on s.iuser=u.sys_pk where s.sys_guid=@sid",p)

        if isnull(rec){ return "" }
        return @@(rec,"$userid")

        exception{}
        return ""
    }

    asrecord::&db,sql,&p
    {
        ref l=dbr.table(db,sql,p)
        new rec { }
        for i=0;i<@count(l)
        {
            rec<trim(cell.str(l,i,0))+"*">:cell.obj(l,i,1)
            exception{}
        }
        
        return rec
    }

    getall::&db
    {
        return asrecord(db,"select varname, varvalue from globalvar",@null)
    }

    getallwhere::&db,where,&p
    {
        return asrecord(db,"select varname, varvalue from globalvar where "+where,p)
    }

    get::&db, varname { return dbr.vars.getd(db,varname,"") }

    getd::&db, varname,default
    {
        new p
        {
            @"varname":varname
            @"sid":""
            @"sid":dbr.getSID(db)
            exception{}
        }
        
        ref gv=@null
        codeblock
        {
            ref gv=dbr.rec(db,"select varvalue,userenable from globalvar where varname=@varname",p)
            exception
            {
                ref gv=dbr.rec(db,"select varvalue from globalvar where varname=@varname",p)
            }
        }

        if isnull(gv) { return default }

        value=@@(gv,"$varvalue")

        if @@(gv,"#userenable")
        {
            using p
            {
                @"uid":userid(db)
            }
            ref gv=dbr.rec(db,"select varvalue from uservarval where varname=@varname and userid=@uid",p)
            if not(isnull(gv)) { return @@(gv,"$varvalue") }
        }

        return value

    }

    has_sys_recver :: &db, tname
    {
        if not(isset("@_cache_sys_recver")) { ref @_cache_sys_recver = record.create() }
        if field.exist(@_cache_sys_recver,tname) { return @@(@_cache_sys_recver, "#"+tname) }

        ref info = dbr.rec(db,"show columns from "+tname+" like 'sys_recver';",@null)
        has_sys_recver = not(isnull(info))
        @_cache_sys_recver<tname> : has_sys_recver

        return has_sys_recver
    }
    save :: &db, tname, &data
    {
        ref fields = list.create_from_fields(data)
        str_fields = replace(ranychars(to.json(fields),'[]{}"'," ")," ","")
        str_fields = "`"+replace(str_fields,",","`,`")+"`"
        count_fields = list.count(fields)

        has_sys_recver = isanyword("`sys_recver`",str_fields)
        if not(has_sys_recver) {
            has_sys_recver = has_sys_recver(db,tname)
        }
        
        sql = "INSERT INTO "+tname+" ("+str_fields+") VALUES ("

        for i = 0; i < count_fields
        {
            if i > 0 { sql = sql + "," }
            sql = sql + "@"+list.str(fields,i)
        }

        sql = sql + ") ON DUPLICATE KEY UPDATE "

        for i = 0; i < count_fields
        {
            field = list.str(fields,i)
            if i > 0 { sql = sql + "," }
            
            sql = sql + "`"+field+"` = "
            if has_sys_recver { sql = sql + "IF(ifnull(sys_recver,0)=0, @"+field+", "+field+")" }
            else { sql = sql + "@"+field }
        }

        sql = sql + ";"
        return dbr.execute(db, sql, data)
    }
    ImportList::&db,&list,tname
    {
        inserts = 0

        for m = 0; m < list.count(list)
        {
            ref record = list.obj(list,m)
            ref fields = list.create_from_fields(record)    
            
            for n = 0; n < list.count(fields)
            {
                field = list.str(fields,n)
                value = @@(record,field)

                if value=="\\N" || value=="\\0" || value=="NULL" { do field.remove(record,field) }
            }
            do save(db,tname,record)
            inserts = (inserts + 1)

            exception{ if not(contains(last_error(),"Duplicate entry")){ do print(last_error()) } }
        }

        do print(ftext("- #<tname>: #<inserts>"))
    }
    /*
    db -> ref a una bd abierta
    lfiles -> obj lista con los nombres de archivos
    dir_path -> directorio en donde se encuentran los archivos dkt
    */
    ImportListDkt::&db,&lfiles,dir_path
    {
        for j = 0; j < @count(lfiles)
        {
            fl=list.str(lfiles,j)
            if trim(fl)!=""
            {
                file=path.concat(dir_path,fl)
                if not(file.exists(file)){do rise_error(99,"No se encontró el archivo: "+fl)}

                ref t=table.from(file.rtext(file))
                table=file.justname(file)
                
                do dbr.vars.InsertRows(db,t,table)
            }
            exception{ do print(last_error()) }
        }
    }
    #!
    InsertRows::&db,&t,tname
    {
        inserts=0
        for i=0;i<table.rows(t)
        {
            ref record=row.get(t,i)
           
            ref fields = list.create_from_fields(record)    
            for n = 0; n < list.count(fields)
            {
                field = list.str(fields,n)
                value = @@(record,"$"+field)                
                if value=="\\N" || value=="\\0" || value=="NULL" || value=="\0" { record<field+"*">:@null }
                if tname=="rh_concepto_nomina" && field=="manual"
                {
                    do field.remove(record,field)
                }
            }
            record<"sys_timestamp*">:now()
            record<"sys_dtcreated*">:now()
            
            do dbr.insert(db,tname,record)
            inserts = (inserts + 1)
            
            exception{ if not(contains(last_error(), "Duplicate entry")){ do print(last_error()) } }
        }
        do print(ftext("- #<tname>: #<inserts>"))
    }
    ImportPrivs::&db,&list
    {
        for i = 0; i < list.count(list)
        {
            ref data = list.obj(list,i)
            new sitem
            {
                @"sys_pk": 0
                @"sys_guid": uuid()
                @"sys_dtcreated*": now()
                @"sys_timestamp*": now()
                @"sys_recver": 0
                @"description": @@(data,"$description")
                @"itemid": @@(data,"$itemid")
                @"itemparent": dbr.num(db,"select sys_pk from sitem where itemid = @itemparent",data)
            }
            if @@(sitem,"#itemparent") == 0 { sitem<"itemparent*"> : @null }

            do dbr.insert(db,"sitem",sitem)
            do print("- " + @@(sitem,"$description"))

            exception{ if not(contains(last_error(), "Duplicate entry")){ do print(last_error()) } }
        }
    }
    
    define::&db,&vardata,catid
    {
        new var
        {
            @"sys_guid": uuid()
            @"sys_timestamp*": dbr.sql("NOW()")
            @"sys_recver": 0
            @"varname": @@(vardata,"$varname")
        }
        
        if field.exist(vardata,"vardefault"){ var<"vardefault">: @@(vardata,"$vardefault") }
        if field.exist(vardata,"varvalue"){ var<"varvalue">: @@(vardata,"$varvalue") }
        if field.exist(vardata,"varcaption"){ var<"varcaption">: @@(vardata,"$varcaption") }
        if field.exist(vardata,"varhelp"){ var<"varhelp">: @@(vardata,"$varhelp") }
        if field.exist(vardata,"vartype"){ var<"vartype">: @@(vardata,"$vartype") }
        if field.exist(vardata,"userenable"){ var<"userenable">: @@(vardata,"$userenable") }
        if field.exist(vardata,"varinput"){
            var<"varinput">: to.json(@@(vardata,"&varinput"))
            exception{}
        }
        if catid != "" { 
            var<"ref_varcat">: catid 
        }
        
        varname=dbr.str(db,"select varname from globalvar where varname=@varname",var)
        if trim(varname)==""{do dbr.insert(db,"globalvar",var)}
        else
        {
            if field.exist(var,"varvalue"){ do field.remove(var,"varvalue") } // Omitir establecer el valor
            do dbr.update(db,"globalvar",var,"varname=@varname",var)
        }
        
        do print(" - " + @@(var,"$varname"))

        exception{ if not(contains(last_error(), "Duplicate entry")){ do print(last_error()) } }
    }
    categories.set::&db,id,caption,help,parent
    {
        new category
        {
            @"id": id
        }
        if trim(caption)!=""{category<"caption">:caption}
        if trim(help)!=""{category<"help">:help}
        if parent != "" { category<"parent">: parent }

        id=dbr.str(db,"select id from varcategory where id=@id",category)
        if trim(id)==""{do dbr.insert(db,"varcategory",category)}
        else{do dbr.update(db,"varcategory",category,"id=@id",category)}

        do print(" - " + @@(category,"$id"))

        exception{ if not(contains(last_error(), "Duplicate entry")){ do print(last_error()) } }
    }
}
