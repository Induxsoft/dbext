#include "dkli.dkh"
#!
module "Variables alojadas en la base de datos :dbr.vars"
{
    userid::&db
    {
        new p { @"sid": dbr.getSID(db) }
        ref rec=dbr.rec(db,"select u.userid from tuser u inner join sys_session s on s.iuser=u.sys_pk where s.sys_guid=@sid",p)

        if isnull(rec){ return "" }
        return @@(rec,"$userid")

        exception{}
        return ""
    }

    asrecord::&db,sql,&p
    {
        ref l=dbr.table(db,sql,p)
        new rec { }
        for i=0;i<@count(l)
        {
            rec<trim(cell.str(l,i,0))+"*">:cell.obj(l,i,1)
            exception{}
        }
        
        return rec
    }

    getall::&db
    {
        return asrecord(db,"select varname, varvalue from globalvar",@null)
    }

    getallwhere::&db,where,&p
    {
        return asrecord(db,"select varname, varvalue from globalvar where "+where,p)
    }

    get::&db, varname { return dbr.vars.getd(db,varname,"") }

    getd::&db, varname,default
    {
        new p
        {
            @"varname":varname
            @"sid":""
            @"sid":dbr.getSID(db)
            exception{}
        }
        
        ref gv=@null
        codeblock
        {
            ref gv=dbr.rec(db,"select varvalue,userenable from globalvar where varname=@varname",p)
            exception
            {
                ref gv=dbr.rec(db,"select varvalue from globalvar where varname=@varname",p)
            }
        }

        if isnull(gv) { return default }

        value=@@(gv,"$varvalue")

        if @@(gv,"#userenable")
        {
            using p
            {
                @"uid":userid(db)
            }
            ref gv=dbr.rec(db,"select varvalue from uservarval where varname=@varname and userid=@uid",p)
            if not(isnull(gv)) { return @@(gv,"$varvalue") }
        }

        return value

    }

    ImportList::&db,&list,tname
    {
        inserts = 0

        for m = 0; m < list.count(list)
        {
            ref record = list.obj(list,m)
            ref fields = list.create_from_fields(record)    
            
            for n = 0; n < list.count(fields)
            {
                field = list.str(fields,n)
                value = @@(record,field)

                if value=="\\N" || value=="\\0" || value=="NULL" { record<field+"*"> : @null }
            }
            
            do dbr.insert(db,tname,record)
            inserts = (inserts + 1)

            exception{ if not(contains(last_error(),"Duplicate entry")){ do print(last_error()) } }
        }

        do print(ftext("- #<tname>: #<inserts>"))
    }
    /*
    db -> ref a una bd abierta
    lfiles -> obj lista con los nombres de archivos
    dir_path -> directorio en donde se encuentran los archivos dkt
    */
    ImportListDkt::&db,&lfiles,dir_path
    {
        for j = 0; j < @count(lfiles)
        {
            fl=list.str(lfiles,j)
            if trim(fl)!=""
            {
                file=path.concat(dir_path,fl)
                if not(file.exists(file)){do rise_error(99,"No se encontró el archivo: "+fl)}

                ref t=table.from(file.rtext(file))
                table=file.justname(file)
                
                do dbr.vars.InsertRows(db,t,table)
            }
            exception{ do print(last_error()) }
        }
    }
    #!
    InsertRows::&db,&t,tname
    {
        inserts=0
        for i=0;i<table.rows(t)
        {
            ref rw=row.get(t,i)
            do dbr.insert(db,tname,rw)
            inserts = (inserts + 1)
            
            exception{ if not(contains(last_error(), "Duplicate entry")){ do print(last_error()) } }
        }
        do print(ftext("- #<tname>: #<inserts>"))
    }
    ImportPrivs::&db,&list
    {
        for i = 0; i < list.count(list)
        {
            ref data = list.obj(list,i)
            new sitem
            {
                @"sys_pk": 0
                @"sys_guid": uuid()
                @"sys_dtcreated*": now()
                @"sys_timestamp*": now()
                @"sys_recver": 0
                @"description": @@(data,"$description")
                @"itemid": @@(data,"$itemid")
                @"itemparent": dbr.num(db,"select sys_pk from sitem where itemid = @itemparent",data)
            }
            if @@(sitem,"#itemparent") == 0 { sitem<"itemparent*"> : @null }

            do dbr.insert(db,"sitem",sitem)
            do print("- " + @@(sitem,"$description"))

            exception{ if not(contains(last_error(), "Duplicate entry")){ do print(last_error()) } }
        }
    }
}